---
/**
 * The practice mark: Dr. Chang's name chop, 張勝雄.
 *
 * The artwork is a real 篆書 (seal script) 朱文 seal — red characters and
 * border, the impression a physical chop actually leaves. 張 occupies the
 * full-height left column with 勝 above 雄 on the right.
 *
 * Replaced 2026-08-24 with a higher-resolution supplied render of the same
 * seal (same characters, same arrangement, already alpha-extracted rather
 * than shot on paper). A prior version sent the same day was AI-generated
 * and garbled the name (雄 duplicated); that one was rejected and never used.
 * This file was verified before use: alpha corners measured 0 and center
 * ink measured ~254, confirming a real transparent cutout, and the edge
 * alpha values are graduated (not a hard 0/255 cutout), preserving stroke
 * texture rather than producing jaggies.
 *
 * WHY IT IS A MASK AND NOT AN <img>.
 * A flat image would bake one theme's ink color into the artwork. Painting
 * an alpha mask with the --seal token instead gives one file that is
 * correct in both themes:
 *
 *   - light mode: --seal is cinnabar on white
 *   - dark mode: --seal lifts to a legible cinnabar on charcoal
 *
 * public/images/chop-mask.png is the seal reduced to alpha only: transparent
 * outside the ink, opaque inside it. 37 KB for a mark that renders at 40px.
 *
 * THE ORIGINAL lives in src-photos/, which is gitignored. Only the derived
 * mask is committed, the same rule the doctor's portrait follows.
 */
import { getTranslation } from '@i18n/locales';

interface Props {
  locale: string;
  size?: number;
}

const { locale, size = 40 } = Astro.props;
const label = getTranslation(locale, 'logoAlt');
---

<span class="chop" role="img" aria-label={label} style={`--chop-size:${size}px`}></span>

<style>
  .chop {
    display: block;
    flex-shrink: 0;
    width: var(--chop-size, 40px);
    height: var(--chop-size, 40px);

    /* The mask carries the shape; --seal carries the color, so the mark is
       cinnabar on white and a lifted cinnabar on charcoal without a second
       file. Never set a background-image here — that would bake one theme's
       ink into the artwork. */
    background-color: var(--seal);
    -webkit-mask-image: url('/images/chop-mask.png');
    mask-image: url('/images/chop-mask.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  /* If mask-image is unsupported, the span above is an empty colored block —
     worse than nothing next to a wordmark. Hide it rather than show a red
     square; the wordmark beside it already names the practice. */
  @supports not ((-webkit-mask-image: url('')) or (mask-image: url(''))) {
    .chop {
      display: none;
    }
  }
</style>
