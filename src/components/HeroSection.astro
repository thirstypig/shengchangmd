---
import CallButton from '@/components/CallButton.astro';
import { practice } from '@/data/practice';
import ServiceIllustration from '@/components/ServiceIllustration.astro';
import { getTranslation } from '@i18n/locales';

interface Props {
  headline: string;
  subheadline: string;
  locale: string;
  /** Path to a portrait/photo. When omitted, a labelled placeholder is shown. */
  image?: string;
  imageAlt?: string;
  /** Caption rendered under the image — used for the doctor's name/credentials. */
  imageCaption?: string;
  /** Render an illustration instead of a photo. Takes precedence over `image`. */
  illustration?: 'family' | 'internal' | 'preventive' | 'chronic' | 'immigration';
  /** 'photo' | 'illustration' | 'placeholder'. Inferred from the props given. */
  media?: 'photo' | 'illustration' | 'placeholder';
}

const {
  headline,
  subheadline,
  locale,
  image,
  imageAlt,
  imageCaption,
  illustration,
  media = illustration ? 'illustration' : image ? 'photo' : 'placeholder',
} = Astro.props;

/*
  These four strings used to live in a private locale map here — a second
  translation system beside src/i18n/locales.ts. It drifted: this file said
  医生 while zh-hant and all 12 pages said 醫師/医师, and it survived a sweep of
  the pages because the sweep read the pages and locales.ts, not this object.

  Neither i18n guard could see it. locale-coverage reads `translations`, so a
  key that never reached locales.ts was outside it; shared-component-labels
  matches literal aria-label/title/alt/data-label attributes, and these were
  object properties.

  Moved into locales.ts 2026-08-10 under `hero`. They are now covered by every
  existing guard for free, including taiwan-register cross-locale parity.

  The old object carried a `?? en` fallback for an unrecognized locale.
  getTranslation returns the key itself in that case, matching the six shared
  components that already use it. Only en/zh-hant/zh-hans are ever passed.
*/
const t = {
  cta: getTranslation(locale, 'hero.cta'),
  placeholder: getTranslation(locale, 'hero.placeholder'),
  boardCertified: getTranslation(locale, 'hero.boardCertified'),
  acceptingPatients: getTranslation(locale, 'hero.acceptingPatients'),
};
---

<section class="bg-gradient-to-b from-primary-50 to-white py-12 md:py-20">
  <div
    class="max-w-container mx-auto px-4 md:px-6 flex flex-col md:flex-row items-center gap-10 md:gap-12"
  >
    {/* Text Content */}
    <div class="flex-1 order-2 md:order-1 text-center md:text-left">
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        {headline}
      </h1>
      <p class="text-xl text-gray-700 mb-8 leading-relaxed">
        {subheadline}
      </p>

      <div class="flex flex-col sm:flex-row items-center md:items-start gap-4">
        <CallButton text={t.cta} size="lg" />
        {
          practice.acceptingNewPatients && (
            <p class="flex items-center gap-2 text-base text-gray-700">
              <span aria-hidden="true" class="text-success text-xl font-bold">✓</span>
              {t.acceptingPatients}
            </p>
          )
        }
      </div>
    </div>

    {/* Media: portrait photo or labelled placeholder */}
    <div class="flex-1 order-1 md:order-2 flex justify-center items-center w-full">
      {
        media === 'illustration' && illustration ? (
          <div class="w-full max-w-sm mx-auto">
            <ServiceIllustration subject={illustration} style="soft" />
          </div>
        ) : media === 'photo' && image ? (
          <figure class="text-center">
            {/*
              Source is a 1024px square crop of the formal portrait, so 320px
              stays sharp even on a 2x display (320 × 2 = 640 ≤ 1024).
            */}
            <img
              src={image}
              alt={imageAlt ?? practice.doctorName}
              width="320"
              height="320"
              loading="eager"
              decoding="async"
              class="w-56 h-56 sm:w-72 sm:h-72 md:w-80 md:h-80 object-cover rounded-2xl shadow-lg ring-4 ring-white mx-auto bg-primary-100"
            />
            <figcaption class="mt-4 text-base text-gray-700">
              <span class="block font-semibold text-gray-900">{practice.doctorName}</span>
              <span class="block text-sm text-gray-600">{imageCaption ?? t.boardCertified}</span>
            </figcaption>
          </figure>
        ) : (
          <div
            class="w-full max-w-md aspect-square bg-primary-100 rounded-2xl flex items-center justify-center border-2 border-dashed border-primary-300"
            role="img"
            aria-label={t.placeholder}
          >
            <p class="text-gray-600 text-sm px-6 text-center">{t.placeholder}</p>
          </div>
        )
      }
    </div>
  </div>
</section>
