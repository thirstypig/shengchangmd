---
import { getTranslation } from '@i18n/locales';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const qrLabel = getTranslation(locale, 'footer.wechatQr');
---

<div class="wechat-qr">
  <img
    src="/images/wechat-qr-small.png"
    alt={qrLabel}
    width="200"
    height="200"
    decoding="async"
  />
  <p class="qr-label">Scan to chat on WeChat</p>
</div>

<style>
  .wechat-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  img {
    width: 160px;
    height: 160px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
  }

  .qr-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
