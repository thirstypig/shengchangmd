---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
}

const { icon, title, description, href } = Astro.props;
---

<div class="bg-white border border-gray-200 rounded-lg p-6 hover:shadow-lg transition-shadow">
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="font-serif text-xl font-semibold text-gray-900 mb-2">
    {title}
  </h3>
  <p class="text-gray-600 mb-4 text-sm leading-relaxed line-clamp-2">
    {description}
  </p>
  <a href={href} class="text-primary-600 hover:text-primary-700 font-medium inline-flex items-center gap-2 transition-colors">
    Learn more
    <span>→</span>
  </a>
</div>
