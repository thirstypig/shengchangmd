---
// A click-to-enlarge photo grid with a lightbox: caption, prev/next, keyboard
// nav (Escape/Arrow keys), and a focus trap while open. No dependency — this
// site ships zero npm UI packages, and the captions come from getTranslation,
// so a self-hosted component keeps trilingual alt text working for free.
import { getTranslation } from '@i18n/locales';

interface Photo {
  src: string;
  alt: string;
}

interface Props {
  photos: Photo[];
  locale: string;
}

const { photos, locale } = Astro.props;

const closeLabel = getTranslation(locale, 'gallery.close');
const prevLabel = getTranslation(locale, 'gallery.previous');
const nextLabel = getTranslation(locale, 'gallery.next');
const viewerLabel = getTranslation(locale, 'gallery.viewer');
---

<div class="photo-gallery">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    {photos.map((photo) => (
      <a href={photo.src} class="gallery-item block">
        <img
          src={photo.src}
          alt={photo.alt}
          loading="lazy"
          class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200 gallery-thumb"
        />
        <p class="gallery-caption-inline">{photo.alt}</p>
      </a>
    ))}
  </div>

  <div class="gallery-overlay surface-deep" hidden>
    <button type="button" class="gallery-btn gallery-close" aria-label={closeLabel}>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4l12 12M16 4L4 16" stroke-linecap="round" />
      </svg>
    </button>
    <button type="button" class="gallery-btn gallery-prev" aria-label={prevLabel}>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 4l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button type="button" class="gallery-btn gallery-next" aria-label={nextLabel}>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 4l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <div class="gallery-panel" role="dialog" aria-modal="true" aria-label={viewerLabel}>
      <figure class="gallery-figure">
        <img class="gallery-lightbox-img" src="" alt="" />
        <figcaption class="gallery-caption"></figcaption>
      </figure>
    </div>
  </div>
</div>

<style>
  .gallery-item {
    text-decoration: none;
  }
  .gallery-thumb {
    cursor: zoom-in;
    transition: transform 0.15s ease;
  }
  .gallery-item:hover .gallery-thumb,
  .gallery-item:focus-visible .gallery-thumb {
    transform: scale(1.02);
  }
  .gallery-caption-inline {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .gallery-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
  }
  .gallery-overlay[hidden] {
    display: none;
  }

  .gallery-panel {
    max-width: 100%;
    max-height: 100%;
    display: flex;
  }
  .gallery-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
  }
  .gallery-lightbox-img {
    max-width: min(90vw, 900px);
    max-height: 70vh;
    object-fit: contain;
    border-radius: 0.5rem;
    background: #ffffff;
  }
  .gallery-caption {
    max-width: 60ch;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .gallery-btn {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 48px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    border: none;
    cursor: pointer;
    z-index: 101;
  }
  .gallery-btn:hover,
  .gallery-btn:focus-visible {
    background: rgba(255, 255, 255, 0.22);
  }
  .gallery-close {
    top: 1rem;
    right: 1rem;
  }
  .gallery-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .gallery-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>('.photo-gallery').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLAnchorElement>('.gallery-item'));
    const overlay = root.querySelector<HTMLDivElement>('.gallery-overlay');
    const img = root.querySelector<HTMLImageElement>('.gallery-lightbox-img');
    const caption = root.querySelector<HTMLElement>('.gallery-caption');
    const closeBtn = root.querySelector<HTMLButtonElement>('.gallery-close');
    const prevBtn = root.querySelector<HTMLButtonElement>('.gallery-prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.gallery-next');

    if (!overlay || !img || !caption || !closeBtn || !prevBtn || !nextBtn || items.length === 0) return;

    const focusable = [closeBtn, prevBtn, nextBtn];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function show(index: number) {
      currentIndex = ((index % items.length) + items.length) % items.length;
      const item = items[currentIndex];
      const thumb = item.querySelector('img');
      const alt = thumb?.alt ?? '';
      img!.src = item.getAttribute('href') ?? '';
      img!.alt = alt;
      caption!.textContent = alt;
    }

    function open(index: number) {
      lastFocused = document.activeElement as HTMLElement | null;
      show(index);
      overlay!.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn!.focus();
    }

    function close() {
      overlay!.hidden = true;
      document.body.style.overflow = '';
      img!.src = '';
      lastFocused?.focus();
    }

    items.forEach((item, i) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        open(i);
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(currentIndex - 1));
    nextBtn.addEventListener('click', () => show(currentIndex + 1));

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    overlay.addEventListener('keydown', (e) => {
      if (overlay!.hidden) return;
      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'ArrowLeft') {
        show(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        show(currentIndex + 1);
      } else if (e.key === 'Tab') {
        const idx = focusable.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        let next = idx + (e.shiftKey ? -1 : 1);
        if (next < 0) next = focusable.length - 1;
        if (next >= focusable.length) next = 0;
        focusable[next].focus();
      }
    });
  });
</script>
