---
import { practice } from '@data/practice';
import { translations } from '@i18n/locales';

/*
  The postal address is derived from practice.addressParts, not restated here.
  Two copies of `streetAddress: '330 W. Las Tunas Drive, Suite 3'` used to sit
  in this file alongside practice.address, so the address a patient reads and
  the address Google indexes could drift apart.

  `geo` was removed on 2026-08-05. It carried latitude 34.0853, longitude
  -118.1085 — hardcoded, never derived from anything, and never verified by
  anyone. CLAUDE.md lists invented map coordinates among this site's original
  fabrications, and structured-data geo is what a search engine uses to place a
  pin on a map: wrong coordinates send a patient to the wrong building.
  Omitting it is safe — Google geocodes `address` on its own. Restore geo only
  with coordinates someone has actually confirmed against the office.
*/
const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: practice.addressParts.street,
  addressLocality: practice.addressParts.locality,
  addressRegion: practice.addressParts.region,
  postalCode: practice.addressParts.postalCode,
  addressCountry: practice.addressParts.country,
};

interface Props {
  locale: string;
  pageSchema?: Record<string, unknown>;
}

const { locale, pageSchema } = Astro.props;

/*
  The doctor's Chinese name, in both scripts, as alternateName on the business
  and the person. Until 2026-09-14 the structured data on all sixteen Chinese
  pages was English only, so nothing machine-readable connected 張勝雄醫師 to
  this practice — which is the name a Chinese-speaking patient searches for.

  `name` stays English and identical in every locale on purpose: the @id is
  shared, so it is one entity described from three pages, not three entities.
  The Chinese name was confirmed by the owner 2026-07-29. It is read from
  locales.ts because a shared component must not contain Chinese.
*/
const alternateName = [translations['zh-hant'].seo.siteName, translations['zh-hans'].seo.siteName];

/*
  The practice, as ONE node. Until 2026-10-15 it was two — a LocalBusiness at
  #organization and a MedicalBusiness at #medical-business — which tells a
  search engine there are two entities, and the four services each named a
  third, anonymous MedicalBusiness as provider. MedicalClinic is a subtype of
  both LocalBusiness and MedicalOrganization, so it carries everything the two
  nodes did plus the properties only a MedicalOrganization may have.

  Three properties here were not schema.org vocabulary and were ignored:
  `acceptsNewPatients` (the property is isAcceptingNewPatients),
  `availableLanguage` (valid only on ContactPoint, Course, LodgingBusiness,
  ServiceChannel, TouristAttraction — an organization uses knowsLanguage), and
  free-text medicalSpecialty values (it expects a MedicalSpecialty member;
  PrimaryCare is the closest — there is no family-medicine member). Checked
  against schema.org 2026-10-15; check 10 in scripts/verify-build.mjs pins
  the types and property names the built site may use.
*/
const organizationId = new URL('/#organization', Astro.site).href;
const organizationRef = { '@id': organizationId };

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': organizationId,
  name: practice.doctorName,
  alternateName,
  description: `Board-certified family physician and USCIS-designated civil surgeon in San Gabriel, California. Dr. ${practice.doctorName.replace(/,.*$/, '')} provides family medicine, immigration medical services, and medical report services.`,
  url: Astro.site.href.replace(/\/$/, ''),
  logo: new URL('/logo.svg', Astro.site).href,
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  address: postalAddress,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: practice.hours.opens,
      closes: practice.hours.closes,
    },
  ],
  // What the office as a whole can serve; the doctor's own two languages are
  // knowsLanguage on the Person below.
  knowsLanguage: practice.languages,
  medicalSpecialty: 'https://schema.org/PrimaryCare',
  isAcceptingNewPatients: practice.acceptingNewPatients,
  areaServed: {
    '@type': 'City',
    name: 'San Gabriel, California',
  },
  priceRange: 'Varies',
};

// Person (Doctor) Schema
const doctorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#doctor', Astro.site).href,
  name: practice.doctorName,
  alternateName,
  givenName: 'Sheng',
  familyName: 'Chang',
  description: 'Board-certified family physician and medical doctor',
  jobTitle: 'Family Physician, Medical Doctor',
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  worksFor: organizationRef,
  knowsLanguage: practice.doctorLanguages,
  /*
    Until 2026-10-15 this block used three properties schema.org does not
    have — `educationDetails`, and `validFrom`/`validUntil` on a credential —
    plus `issuedBy`, which is defined only for Certification/Permit/Ticket. So
    nothing here was read. Worse, two of its values were invented:
    `validUntil` was mostRecentCertification + 10, an expiry date nobody
    supplied, and the EducationEvent's `startDate` was the graduation year
    minus four, a medical-school start nobody supplied. Fixing the names
    without removing those would have published both. Emit only what
    practice.ts holds: the board, the first-certified year, the degree, the
    school and the graduation year.
  */
  hasCredential: [
    ...practice.boardCertifications.map((cert) => ({
      '@type': 'EducationalOccupationalCredential',
      name: `Board Certified in ${cert.specialty}`,
      credentialCategory: 'Certification',
      recognizedBy: {
        '@type': 'Organization',
        name: cert.board,
      },
      dateCreated: `${cert.firstCertified}`,
    })),
    {
      '@type': 'EducationalOccupationalCredential',
      name: `${practice.education.medicalDegree}, ${practice.education.school}`,
      credentialCategory: 'degree',
      recognizedBy: {
        '@type': 'CollegeOrUniversity',
        name: practice.education.school,
      },
      dateCreated: `${practice.education.year}`,
    },
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: practice.education.school,
  },
};

// ContactPoint Schema
const contactPointSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPoint',
  '@id': new URL('/#contact-point', Astro.site).href,
  contactType: 'Patient Services',
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  hoursAvailable: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: practice.hours.opens,
      closes: practice.hours.closes,
    },
  ],
  areaServed: {
    '@type': 'City',
    name: 'San Gabriel, California',
  },
};

// Service Schemas. `Service`, not `MedicalService`: there is no MedicalService
// type in schema.org, so until 2026-10-15 all four of these — the I-693 entry
// included — were a type search engines do not recognize.
const servicesSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': new URL('/services/#family-medicine', Astro.site).href,
    name: 'Family Medicine',
    // "for patients of all ages, from newborns to seniors" until 2026-08-07.
    // The practice sees adults only - no patients under 18 - per the owner's
    // written scope of 2026-08-06. Structured data is what Google, Apple Maps
    // and voice assistants read, so a stale claim here reaches a parent who
    // never opens the page.
    description: 'Comprehensive family medicine care for adults, including preventive care, acute illness treatment, and chronic disease management.',
    provider: organizationRef,
    areaServed: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': new URL('/immigration-medical-exam/#service', Astro.site).href,
    url: new URL('/immigration-medical-exam/', Astro.site).href,
    name: 'Immigration Medical Services (Form I-693)',
    description:
      'Immigration medical examination completed by a USCIS-designated civil surgeon, with Form I-693 sealed for submission with an adjustment of status application.',
    provider: organizationRef,
    areaServed: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': new URL('/services/#citizenship-waiver', Astro.site).href,
    name: 'Citizenship Exam Waiver Medical Evaluation Report (Form N-648)',
    description:
      'Medical certification for disability exceptions, Form N-648, for naturalization applicants seeking an exception to the English and civics testing requirements. USCIS decides the request; the physician provides the certification.',
    provider: organizationRef,
    areaServed: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': new URL('/services/#medical-legal', Astro.site).href,
    name: 'Medical-Legal Reports',
    description:
      'Written medical reports and evaluations prepared for legal and administrative proceedings.',
    provider: organizationRef,
    areaServed: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  /*
    Stem cell therapy is deliberately absent from the structured data while the
    page copy is still an unconfirmed placeholder. Structured data is the part
    search engines and assistants ingest verbatim, so emitting a Service
    for a treatment whose type, indications and regulatory basis nobody has
    supplied would assert a clinical claim the practice has not reviewed. Add it
    here once services.astro carries confirmed copy.
  */
];

// Combine all schemas
const schemas = [
  organizationSchema,
  doctorSchema,
  contactPointSchema,
  ...servicesSchema,
  pageSchema,
].filter(Boolean);
---

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
