---
import { practice } from '@data/practice';

interface Props {
  locale: string;
  pageSchema?: Record<string, unknown>;
}

const { locale, pageSchema } = Astro.props;

// LocalBusiness Schema
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#organization', Astro.site).href,
  name: practice.doctorName,
  description: `Board-certified family physician and USCIS-designated civil surgeon in San Gabriel, California. Dr. ${practice.doctorName.replace(', M.D.', '')} provides family medicine, immigration medical examinations, and medical report services.`,
  url: Astro.site.href.replace(/\/$/, ''),
  logo: new URL('/logo.svg', Astro.site).href,
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '330 W. Las Tunas Drive, Suite 3',
    addressLocality: 'San Gabriel',
    addressRegion: 'CA',
    postalCode: '91776',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 34.0853,
    longitude: -118.1085,
  },
};

// MedicalBusiness Schema
const medicalBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': new URL('/#medical-business', Astro.site).href,
  name: practice.doctorName,
  description: `Board-certified family physician and USCIS-designated civil surgeon in San Gabriel, California. Dr. ${practice.doctorName.replace(', M.D.', '')} provides family medicine, immigration medical examinations, and medical report services.`,
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '330 W. Las Tunas Drive, Suite 3',
    addressLocality: 'San Gabriel',
    addressRegion: 'CA',
    postalCode: '91776',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 34.0853,
    longitude: -118.1085,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '12:00',
    },
  ],
  availableLanguage: practice.languages,
  medicalSpecialty: practice.practiceAreas.primary.concat(
    practice.practiceAreas.secondary,
  ),
  areaServed: {
    '@type': 'City',
    name: 'San Gabriel',
  },
  priceRange: 'Varies',
  acceptsNewPatients: practice.acceptingNewPatients,
};

// Person (Doctor) Schema
const doctorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#doctor', Astro.site).href,
  name: practice.doctorName,
  givenName: 'Sheng',
  familyName: 'Chang',
  description: 'Board-certified family physician and medical doctor',
  jobTitle: 'Family Physician, Medical Doctor',
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  worksFor: {
    '@type': 'Organization',
    name: practice.doctorName,
  },
  knowsLanguage: practice.languages,
  hasCredential: practice.boardCertifications.map((cert) => ({
    '@type': 'EducationalOccupationalCredential',
    name: `Board Certified in ${cert.specialty}`,
    credentialCategory: 'Certification',
    issuedBy: {
      '@type': 'Organization',
      name: cert.board,
    },
    validFrom: `${cert.firstCertified}`,
    validUntil: cert.mostRecentCertification
      ? `${cert.mostRecentCertification + 10}`
      : undefined,
  })),
  educationDetails: {
    '@type': 'EducationEvent',
    name: `${practice.education.medicalDegree} from ${practice.education.school}`,
    educationLevel: 'DoctorateType',
    startDate: `${practice.education.year - 4}`,
    endDate: `${practice.education.year}`,
  },
};

// ContactPoint Schema
const contactPointSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPoint',
  '@id': new URL('/#contact-point', Astro.site).href,
  contactType: 'Patient Services',
  telephone: practice.phone,
  email: `mailto:${practice.email}`,
  hoursAvailable: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '12:00',
    },
  ],
  areaServed: {
    '@type': 'City',
    name: 'San Gabriel, California',
  },
};

// Service Schemas
const servicesSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalService',
    '@id': new URL('/services/#family-medicine', Astro.site).href,
    name: 'Family Medicine',
    description: 'Comprehensive family medicine care for patients of all ages, from newborns to seniors. Includes preventive care, acute illness treatment, and chronic disease management.',
    provider: {
      '@type': 'MedicalBusiness',
      name: practice.doctorName,
    },
    serviceArea: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalService',
    '@id': new URL('/services/#immigration-exams', Astro.site).href,
    name: 'Immigration Medical Examination (Form I-693)',
    description:
      'Immigration medical examination completed by a USCIS-designated civil surgeon, with Form I-693 sealed for submission with an adjustment of status application.',
    provider: {
      '@type': 'MedicalBusiness',
      name: practice.doctorName,
    },
    serviceArea: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalService',
    '@id': new URL('/services/#citizenship-waiver', Astro.site).href,
    name: 'Citizenship Test Medical Waiver (Form N-648)',
    description:
      'Medical certification for disability exceptions, Form N-648, for naturalisation applicants seeking an exception to the English and civics testing requirements. USCIS decides the request; the physician provides the certification.',
    provider: {
      '@type': 'MedicalBusiness',
      name: practice.doctorName,
    },
    serviceArea: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalService',
    '@id': new URL('/services/#medical-legal', Astro.site).href,
    name: 'Medical-Legal Reports',
    description:
      'Written medical reports and evaluations prepared for legal and administrative proceedings.',
    provider: {
      '@type': 'MedicalBusiness',
      name: practice.doctorName,
    },
    serviceArea: {
      '@type': 'City',
      name: 'San Gabriel, California',
    },
  },
  /*
    Stem cell therapy is deliberately absent from the structured data while the
    page copy is still an unconfirmed placeholder. Structured data is the part
    search engines and assistants ingest verbatim, so emitting a MedicalService
    for a treatment whose type, indications and regulatory basis nobody has
    supplied would assert a clinical claim the practice has not reviewed. Add it
    here once services.astro carries confirmed copy.
  */
];

// Combine all schemas
const schemas = [
  localBusinessSchema,
  medicalBusinessSchema,
  doctorSchema,
  contactPointSchema,
  ...servicesSchema,
  pageSchema,
].filter(Boolean);
---

{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
