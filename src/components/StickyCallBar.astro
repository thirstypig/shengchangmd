---
/**
 * Mobile-only sticky call bar.
 *
 * Seniors overwhelmingly prefer phoning over filling in a form, and the
 * header CTA scrolls out of reach on long pages. This keeps a 64px-tall
 * tap target — well above the 48px WCAG floor — anchored to the bottom of
 * the viewport on small screens, where the thumb already rests.
 */
import { practice } from '@/data/practice';
import { getTranslation } from '@i18n/locales';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

/*
  Was a private locale map, a second translation system beside locales.ts.
  Moved 2026-08-10; see the note above the `hero` block there.

  The aria label keeps the phone number OUT of locales.ts and substitutes it
  here. source-integrity fails the build if the office number appears anywhere
  outside practice.ts, and that rule is worth more than the convenience of
  storing the finished sentence.
*/
const t = {
  label: getTranslation(locale, 'stickyCall.label'),
  aria: getTranslation(locale, 'stickyCall.aria').replace('{phone}', practice.phone),
};

const phoneUrl = `tel:+1${practice.phone.replace(/\D/g, '')}`;
---

<div class="sticky-call-bar md:hidden">
  <a href={phoneUrl} class="sticky-call-link" aria-label={t.aria}>
    <svg
      class="sticky-call-icon"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8.1 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.7 2Z"
      ></path>
    </svg>
    <span class="sticky-call-text">
      <span class="sticky-call-label">{t.label}</span>
      <span class="sticky-call-number">{practice.phone}</span>
    </span>
  </a>
</div>

<style>
  .sticky-call-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--surface);
    border-top: 1px solid var(--line);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.12);
    /* Clear the home-indicator area on notched phones. */
    padding: 0.5rem 1rem calc(0.5rem + env(safe-area-inset-bottom));
  }

  .sticky-call-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 64px;
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--brand);
    color: var(--surface);
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
  }

  .sticky-call-link:active {
    background: var(--brand-strong);
  }

  .sticky-call-link:focus-visible {
    outline: 3px solid var(--text-strong);
    outline-offset: 2px;
  }

  .sticky-call-icon {
    flex-shrink: 0;
  }

  .sticky-call-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .sticky-call-label {
    font-size: 0.95rem;
  }

  .sticky-call-number {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
</style>
