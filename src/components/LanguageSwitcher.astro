---
import { locales } from '@i18n/locales';

interface Props {
  currentLocale: string;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;

// Map of locale codes to their URL prefixes
const localeToPrefix = {
  en: '',
  'zh-hant': '/zh-hant',
  'zh-hans': '/zh-hans',
};

// Get clean path without locale prefix
function getCleanPath(path: string): string {
  if (path.startsWith('/zh-hant/')) {
    return path.slice('/zh-hant'.length);
  }
  if (path.startsWith('/zh-hans/')) {
    return path.slice('/zh-hans'.length);
  }
  return path;
}

const cleanPath = getCleanPath(currentPath);

// Build links for each locale
const localeLinks = Object.entries(locales).map(([code, metadata]) => {
  const prefix = localeToPrefix[code as keyof typeof localeToPrefix];
  const href = prefix + (cleanPath || '/');
  return {
    code,
    href,
    // Compact label ("EN", "繁體", "简体") — the full names overflowed the
    // mobile utility bar.
    name: metadata.shortName,
    fullName: metadata.nativeName,
    isCurrent: code === currentLocale,
  };
});
---

<nav class="language-switcher" aria-label="Language selection">
  {
    localeLinks.map((link) => (
      <a
        href={link.href}
        lang={link.code}
        aria-current={link.isCurrent ? 'page' : undefined}
        title={link.fullName}
        aria-label={link.fullName}
        class:list={['language-link', { 'is-current': link.isCurrent }]}
      >
        {link.name}
      </a>
    ))
  }
</nav>

<style>
  .language-switcher {
    display: flex;
    gap: 0.125rem;
    font-size: 0.875rem;
  }

  .language-link {
    display: inline-flex;
    align-items: center;
    /* 40px tall rather than 48: this is a compact utility strip, and the links
       still exceed the 24px AAA target-size minimum with room to spare. */
    min-height: 40px;
    padding: 0.5rem 0.5rem;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }

  .language-link:hover {
    border-bottom-color: currentColor;
  }

  .language-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .language-link.is-current {
    border-bottom-color: currentColor;
    font-weight: 600;
  }
</style>
