---
interface Props {
  locale: string;
}

const { locale } = Astro.props;

const navItems = {
  en: [
    { href: '/', label: 'Home' },
    { href: '/services/', label: 'Services' },
    { href: '/hours/', label: 'Hours' },
    { href: '/location/', label: 'Location' },
    { href: '/insurance/', label: 'Insurance' },
    { href: '/new-patients/', label: 'New patients' },
  ],
  'zh-hant': [
    { href: '/zh-hant/', label: '首頁' },
    { href: '/zh-hant/services/', label: '診療項目' },
    { href: '/zh-hant/hours/', label: '門診時間' },
    { href: '/zh-hant/location/', label: '診所位置' },
    { href: '/zh-hant/insurance/', label: '保險' },
    { href: '/zh-hant/new-patients/', label: '初診患者' },
  ],
  'zh-hans': [
    { href: '/zh-hans/', label: '首页' },
    { href: '/zh-hans/services/', label: '诊疗项目' },
    { href: '/zh-hans/hours/', label: '门诊时间' },
    { href: '/zh-hans/location/', label: '诊所位置' },
    { href: '/zh-hans/insurance/', label: '保险' },
    { href: '/zh-hans/new-patients/', label: '初诊患者' },
  ],
};

const items = navItems[locale as keyof typeof navItems] || navItems.en;
---

<nav class="page-nav" aria-label="Main navigation">
  {items.map((item) => (
    <a href={item.href} class="nav-button">
      {item.label}
    </a>
  ))}
</nav>

<style is:global>
  .page-nav {
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  .nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 1rem;
    background-color: var(--surface-sunken);
    border: 1px solid var(--line);
    border-radius: 2px;
    text-decoration: none;
    color: var(--text-strong);
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .nav-button:hover {
    background-color: var(--brand);
    color: var(--surface);
    border-color: var(--brand);
  }

  .nav-button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .page-nav {
      gap: 0.4rem;
    }

    .nav-button {
      min-height: 44px;
      padding: 0 0.75rem;
      font-size: 0.8rem;
    }
  }
</style>
