---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { practice } from '@data/practice';
import { locales, getTranslation, getPracticeLocalized } from '@i18n/locales';
import Header from '@components/Header.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import JsonLd from '@components/JsonLd.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  locale: string;
  ogImage?: string;
  canonicalUrl: string;
  breadcrumbs?: BreadcrumbItem[];
  pageSchema?: Record<string, unknown>;
}

const { title, description, locale, ogImage, canonicalUrl, breadcrumbs, pageSchema } = Astro.props;

const localeMetadata = locales[locale as keyof typeof locales] || locales['en'];
const isReviewed = localeMetadata?.reviewed ?? false;

// Search engines are blocked unless ALLOW_INDEXING is explicitly set at build
// time. Default-closed on purpose: the site currently carries content nobody has
// confirmed (insurance carriers, the doctor's Chinese name, immigration-exam
// scope), and a staging URL that gets indexed is hard to un-index.
const allowIndexing = process.env.ALLOW_INDEXING === 'true';
const noIndex = !allowIndexing || !isReviewed;

// Set default og:image if not provided
const finalOgImage = ogImage || new URL('/og-image.png', Astro.site).href;

const t = (key: string) => getTranslation(locale, key);
const pl = getPracticeLocalized(locale);

// Privacy and accessibility exist only in English so far; point non-English
// visitors at the English copy rather than a 404 until they are translated.
const legalPrefix = '';

const hreflangLinks = Object.entries(locales).map(([code, metadata]) => ({
  lang: metadata.code,
  href: canonicalUrl.replace(
    /^(https?:\/\/[^/]+)(\/)?.*$/,
    (match, domain, slash) => {
      const basePath = domain + (slash || '/');
      if (code === 'en') {
        return basePath + canonicalUrl.split('/').slice(3).join('/');
      }
      return basePath + code + '/' + canonicalUrl.split('/').slice(3).join('/');
    },
  ),
}));

const xDefaultHref = canonicalUrl.replace(/\/(zh-hans|zh-hant)\//, '/');
---

<!doctype html>
<html lang={localeMetadata?.code || 'en-US'} style="--font-scale: 1;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    {
      hreflangLinks.map((link) => (
        <link rel="alternate" hrefLang={link.lang} href={link.href} />
      ))
    }
    <link rel="alternate" hrefLang="x-default" href={xDefaultHref} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={practice.doctorName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMetadata?.code || 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />

    {/*
      Resolve the theme before first paint, otherwise a visitor who chose dark
      sees a white flash on every navigation. Inline and synchronous by
      necessity — a deferred module would run after the first paint.
    */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* Private browsing can reject reads. */
        }
        const prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme =
          stored === 'dark' || stored === 'light' ? stored : prefersDark ? 'dark' : 'light';
      })();
    </script>

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%238a2f3c'/><text x='16' y='23' font-size='18' font-family='Georgia,serif' fill='white' text-anchor='middle'>SC</text></svg>"
    />

    {breadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: new URL(item.href, Astro.site).href,
        })),
      })} />
    )}

  </head>

  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <!-- Header -->
    <Header locale={locale} currentPath={Astro.url.pathname} />

    <!-- Main content -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-column">
          <h3>{t('footer.officeInformation')}</h3>
          <dl>
            <dt>{t('footer.hours')}</dt>
            <dd>
              <div>{t('hoursWeekday')}</div>
              <div>{t('hoursWeekend')}</div>
            </dd>
            <dt>{t('footer.address')}</dt>
            <dd>
              <a
                href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(practice.address)}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {practice.address}
              </a>
            </dd>
            <dt>{t('footer.phone')}</dt>
            <dd>
              <a href={`tel:+1${practice.phone.replace(/\D/g, '')}`}>
                {practice.phone}
              </a>
            </dd>
          </dl>
        </div>

        <div class="footer-column">
          <h3>{t('footer.professional')}</h3>
          <p>{t('footer.license')} {practice.medicalLicenseNumber}</p>
          <p>{pl.licenseStatus}</p>
        </div>

        <div class="footer-column">
          <h3>{t('footer.legal')}</h3>
          <ul>
            <li><a href={`${legalPrefix}/privacy/`}>{t('footer.privacy')}</a></li>
            <li>
              <a href={`${legalPrefix}/accessibility/`}>{t('footer.accessibility')}</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>
          &copy; {new Date().getFullYear()} {practice.doctorName}. {t('footer.rightsReserved')}
        </p>
      </div>
    </footer>

    <StickyCallBar locale={locale} />

    <JsonLd locale={locale} pageSchema={pageSchema} />
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 999;
  }

  .skip-to-content:focus {
    top: 0;
    left: 0;
    right: auto;
    bottom: auto;
    padding: 1rem;
    background: var(--text-strong);
    color: var(--surface);
    text-decoration: none;
  }

  /* No max-width here: pages own their own width. Clamping <main> was cutting
     the homepage's full-bleed banded sections into a floating inset panel. */
  main {
    min-height: calc(100vh - 400px);
  }

  .footer {
    background: var(--surface-sunken);
    border-top: 1px solid var(--line);
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .footer-column h3 {
    font-size: 1.05rem;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .footer-column dl {
    margin: 0;
  }

  .footer-column dt {
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }

  .footer-column dd {
    margin: 0;
    margin-bottom: 1rem;
  }

  .footer-column a {
    color: var(--brand-strong);
    text-decoration: none;
  }

  .footer-column a:hover {
    text-decoration: underline;
  }

  .footer-column a:focus-visible {
    outline: 2px solid var(--brand-strong);
    outline-offset: 2px;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column li {
    margin-bottom: 0.5rem;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    border-top: 1px solid var(--line);
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      text-align: center;
    }

    .header-left,
    .header-center,
    .header-right {
      width: 100%;
    }

    .main-nav {
      flex-direction: column;
      gap: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .nav-link {
      display: block;
      text-align: center;
      padding: 0.5rem;
    }

  }
</style>
