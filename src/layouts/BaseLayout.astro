---
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { practice } from '@data/practice';
import { locales } from '@i18n/locales';
import Header from '@components/Header.astro';
import StickyCallBar from '@components/StickyCallBar.astro';
import JsonLd from '@components/JsonLd.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  locale: string;
  ogImage?: string;
  canonicalUrl: string;
  breadcrumbs?: BreadcrumbItem[];
  pageSchema?: Record<string, unknown>;
}

const { title, description, locale, ogImage, canonicalUrl, breadcrumbs, pageSchema } = Astro.props;

const localeMetadata = locales[locale as keyof typeof locales] || locales['en'];
const isReviewed = localeMetadata?.reviewed ?? false;

// Set default og:image if not provided
const finalOgImage = ogImage || 'https://shengchangmd.com/og-image.png';

const navItems = {
  en: [
    { href: '/', label: 'Home' },
    { href: '/the-doctor/', label: 'The doctor' },
    { href: '/services/', label: 'Services' },
    { href: '/hours/', label: 'Hours' },
    { href: '/location/', label: 'Location' },
    { href: '/insurance/', label: 'Insurance' },
    { href: '/new-patients/', label: 'New patients' },
  ],
  'zh-hant': [
    { href: '/zh-hant/', label: '首頁' },
    { href: '/zh-hant/the-doctor/', label: '關於醫師' },
    { href: '/zh-hant/services/', label: '診療項目' },
    { href: '/zh-hant/hours/', label: '門診時間' },
    { href: '/zh-hant/location/', label: '診所位置' },
    { href: '/zh-hant/insurance/', label: '保險' },
    { href: '/zh-hant/new-patients/', label: '初診患者' },
  ],
  'zh-hans': [
    { href: '/zh-hans/', label: '首页' },
    { href: '/zh-hans/the-doctor/', label: '关于医师' },
    { href: '/zh-hans/services/', label: '诊疗项目' },
    { href: '/zh-hans/hours/', label: '门诊时间' },
    { href: '/zh-hans/location/', label: '诊所位置' },
    { href: '/zh-hans/insurance/', label: '保险' },
    { href: '/zh-hans/new-patients/', label: '初诊患者' },
  ],
};

const currentNavItems = navItems[locale as keyof typeof navItems] || navItems.en;

const hreflangLinks = Object.entries(locales).map(([code, metadata]) => ({
  lang: metadata.code,
  href: canonicalUrl.replace(
    /^(https?:\/\/[^/]+)(\/)?.*$/,
    (match, domain, slash) => {
      const basePath = domain + (slash || '/');
      if (code === 'en') {
        return basePath + canonicalUrl.split('/').slice(3).join('/');
      }
      return basePath + code + '/' + canonicalUrl.split('/').slice(3).join('/');
    },
  ),
}));

const xDefaultHref = canonicalUrl.replace(/\/(zh-hans|zh-hant)\//, '/');
---

<!doctype html>
<html lang={localeMetadata?.code || 'en-US'} style="--font-scale: 1;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {!isReviewed && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    {
      hreflangLinks.map((link) => (
        <link rel="alternate" hrefLang={link.lang} href={link.href} />
      ))
    }
    <link rel="alternate" hrefLang="x-default" href={xDefaultHref} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={practice.doctorName} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={localeMetadata?.code || 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='24' font-size='24'>⚕️</text></svg>"
    />

    {breadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: `https://shengchangmd.com${item.href}`,
        })),
      })} />
    )}

  </head>

  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>

    <!-- Header -->
    <Header locale={locale} currentPath={Astro.url.pathname} />

    <!-- Main content -->
    <main id="main">
      <slot />
    </main>

    <!-- CTA Banner -->
    <section class="cta-banner">
      <div class="cta-content">
        <span class="cta-label">CALL THE OFFICE</span>
        <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="cta-phone">
          {practice.phone}
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-column">
          <h3>Office Information</h3>
          <dl>
            <dt>Hours</dt>
            <dd>
              <div>{practice.hours.weekday}</div>
              <div>{practice.hours.weekend}</div>
            </dd>
            <dt>Address</dt>
            <dd>
              <a href="https://maps.google.com/?q=330+W.+Las+Tunas+Drive,+Suite+3,+San+Gabriel,+CA+91776">
                {practice.address}
              </a>
            </dd>
            <dt>Phone</dt>
            <dd>
              <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`}>
                {practice.phone}
              </a>
            </dd>
          </dl>
        </div>

        <div class="footer-column">
          <h3>Professional</h3>
          <p>California Medical License {practice.medicalLicenseNumber}</p>
          <p>{practice.medicalLicenseStatus}</p>
        </div>

        <div class="footer-column">
          <h3>Legal</h3>
          <ul>
            <li><a href="/privacy/">Privacy Policy</a></li>
            <li><a href="/accessibility/">Accessibility Statement</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} {practice.doctorName}. All rights reserved.</p>
      </div>
    </footer>

    <StickyCallBar locale={locale} />

    <JsonLd locale={locale} pageSchema={pageSchema} />
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -9999px;
    left: -9999px;
    z-index: 999;
  }

  .skip-to-content:focus {
    top: 0;
    left: 0;
    right: auto;
    bottom: auto;
    padding: 1rem;
    background: #1a1a1a;
    color: #fff;
    text-decoration: none;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    min-height: calc(100vh - 400px);
  }

  .cta-banner {
    background: #3d2b52;
    color: #fff;
    padding: 2rem 1rem;
    margin: 2rem auto;
    max-width: 1200px;
    border-radius: 2px;
  }

  .cta-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cta-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .cta-phone {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .cta-phone:hover {
    opacity: 0.9;
  }

  .cta-phone:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .footer {
    background: #f9f9f9;
    border-top: 1px solid #ddd;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .footer-column h3 {
    font-size: 1.05rem;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .footer-column dl {
    margin: 0;
  }

  .footer-column dt {
    font-weight: 600;
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }

  .footer-column dd {
    margin: 0;
    margin-bottom: 1rem;
  }

  .footer-column a {
    color: #3d2b52;
    text-decoration: none;
  }

  .footer-column a:hover {
    text-decoration: underline;
  }

  .footer-column a:focus-visible {
    outline: 2px solid #3d2b52;
    outline-offset: 2px;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column li {
    margin-bottom: 0.5rem;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    border-top: 1px solid #ddd;
    text-align: center;
    font-size: 0.875rem;
    color: #666;
  }

  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      text-align: center;
    }

    .header-left,
    .header-center,
    .header-right {
      width: 100%;
    }

    .main-nav {
      flex-direction: column;
      gap: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .nav-link {
      display: block;
      text-align: center;
      padding: 0.5rem;
    }

    .cta-content {
      flex-direction: column;
      text-align: center;
    }

    .cta-phone {
      font-size: 1.5rem;
    }
  }
</style>
