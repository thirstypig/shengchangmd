---
import BaseLayout from '@layouts/BaseLayout.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';

const title = 'Contact Us | Sheng Chang, M.D.';
const description = 'Contact Dr. Sheng Chang in San Gabriel, California. Call, visit our office, or send a message.';
const canonicalUrl = new URL('/contact/', Astro.site).href;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  {/* Hero Section */}
  <section class="bg-gradient-to-b from-primary-50 to-white py-12 md:py-20">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Contact Us
      </h1>
      <p class="text-xl text-gray-700 leading-relaxed max-w-2xl">
        Have questions or ready to schedule an appointment? We're here to help. Call us directly or send a message and we'll get back to you soon.
      </p>
    </div>
  </section>

  {/* Contact Content Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">

        {/* Left Column: Call & Visit Info */}
        <div class="space-y-12">

          {/* Call Us Section */}
          <div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-6">
              Call Us
            </h2>
            <p class="text-gray-600 mb-4">
              The quickest way to reach us is by phone. We're happy to answer your questions and schedule appointments.
            </p>
            <a href={`tel:+1${practice.phone.replace(/\D/g, '')}`} class="inline-block">
              <div class="text-2xl md:text-3xl font-bold text-primary-600 hover:text-primary-700 transition-colors mb-6">
                {practice.phone}
              </div>
            </a>
            <CallButton text="Call Now" size="base" />
          </div>

          {/* Visit Us Section */}
          <div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-6">
              Visit Us
            </h2>

            <div class="mb-6">
              <h3 class="font-semibold text-gray-900 mb-2">Office Address</h3>
              <p class="text-gray-700 leading-relaxed">
                {practice.address}
              </p>
            </div>

            <div class="mb-6">
              <h3 class="font-semibold text-gray-900 mb-2">Office Hours</h3>
              <p class="text-gray-700 mb-2">
                <strong>Weekdays:</strong> {practice.hours.weekday}
              </p>
              <p class="text-gray-700">
                <strong>Weekends:</strong> {practice.hours.weekend}
              </p>
            </div>

            <a
              href="https://maps.google.com/?q=330+W.+Las+Tunas+Drive,+Suite+3,+San+Gabriel,+CA+91776"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition-colors"
            >
              Get Directions
            </a>
          </div>
        </div>

        {/*
          Right Column: how to reach the office.

          A contact form stood here until 2026-08-05. It never sent anything:
          the submit handler called preventDefault(), popped an alert saying
          "Thank you for your message! We will get back to you soon", and reset
          the fields. The code comment called it a demo. The English and
          Simplified Chinese pages carried a "Demo Form" notice below the
          fields — after a visitor had already filled them in — and the
          Traditional Chinese page carried no notice at all.

          On a medical practice site that is the most harmful defect on the
          page: a patient describes a health concern, is told the practice will
          respond, and nobody ever sees it. Replaced with routes that actually
          reach the office. Do not reinstate a form without a real endpoint
          behind it, and note that a plain form is the wrong place for patient
          health information anyway.
        */}
        <div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-6">
            How to Reach the Office
          </h2>
          <p class="text-gray-600 mb-8">
            The office handles appointments and questions by phone. Email is fine for
            non-urgent matters, though the phone is faster.
          </p>

          <div class="space-y-4">
            <a
              href={`tel:+1${practice.phone.replace(/\D/g, '')}`}
              class="block w-full text-center px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition-colors"
            >
              Call {practice.phone}
            </a>
            <a
              href={`mailto:${practice.email}`}
              class="block w-full text-center px-8 py-4 border border-primary-600 text-primary-700 font-semibold rounded-lg hover:bg-primary-50 transition-colors"
            >
              Email {practice.email}
            </a>
            <div class="bg-primary-50 border border-primary-200 rounded-lg p-4 text-sm text-gray-700">
              <p>Please do not use email for anything urgent. If this is a medical emergency, call 911.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

