---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';
import '../styles/pages/hours.css';

const title = `Office Hours | ${practice.doctorName} | San Gabriel, CA`;
const description = `Office hours for Dr. Chang's family medicine practice in San Gabriel, California: ${practice.hours.weekday}. ${practice.hours.weekend}.`;
const canonicalUrl = new URL('/hours/', Astro.site).href;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Hours', href: '/hours/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <section class="content-section">
    <div class="content-left">
      <h1>Office Hours</h1>
      <div class="hours-list">
        <div class="hours-item">
          <span>{practice.hours.weekday}</span>
        </div>
        <div class="hours-item">
          <span>{practice.hours.weekend}</span>
        </div>
      </div>
      <p class="hours-note">
        If you call when the office is closed, please leave a message. Calls are
        returned the next business day.
      </p>
    </div>
  </section>
</BaseLayout>
