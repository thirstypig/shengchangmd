---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';

const title = 'About Dr. Sheng Chang, M.D. | Board-Certified Family Physician';
const description = 'Learn about Dr. Sheng Chang, M.D., a board-certified family physician with decades of clinical experience in San Gabriel, California. Education, certifications, and hospital affiliations.';
const canonicalUrl = 'https://shengchangmd.com/about/';
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
>
  {/* Hero Section */}
  <HeroSection
    headline="About Dr. Sheng Chang, M.D."
    subheadline="A board-certified family physician with decades of clinical experience dedicated to providing compassionate, comprehensive medical care to patients of all ages in San Gabriel and the surrounding communities."
    locale="en"
  />

  {/* Bio Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-gray-900">
          Professional Background
        </h2>
        <div class="prose prose-lg text-gray-700 space-y-6">
          <p class="leading-relaxed">
            Dr. Sheng Chang brings decades of dedicated clinical experience to his family medicine practice in San Gabriel. His medical career is built on the foundation of rigorous scientific training, combined with a deep commitment to patient-centered care and building long-lasting relationships with his patients.
          </p>
          <p class="leading-relaxed">
            As a board-certified family physician, Dr. Chang provides comprehensive primary care for patients of all ages. He specializes in preventive medicine, chronic disease management, and internal medicine, with particular expertise in managing complex medical conditions. His approach emphasizes personalized, thoughtful care tailored to each patient's individual needs, goals, and health status.
          </p>
          <p class="leading-relaxed">
            Dr. Chang's clinical philosophy centers on evidence-based medicine, patient education, and the establishment of continuity of care—factors that research shows lead to better health outcomes and greater patient satisfaction. He believes that the best medical care comes from truly understanding each patient's complete health picture and working collaboratively to achieve their health goals.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Credentials & Languages Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        Credentials & Professional Information
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {/* Medical Degree */}
        <div class="bg-white rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            Medical Degree
          </h3>
          <p class="text-gray-700 mb-2">
            <span class="font-semibold">{practice.education.medicalDegree}</span>
          </p>
          <p class="text-gray-600 text-sm mb-2">
            {practice.education.school}
          </p>
          <p class="text-gray-600 text-sm">
            Graduated {practice.education.year}
          </p>
        </div>

        {/* Medical License */}
        <div class="bg-white rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            California Medical License
          </h3>
          <p class="text-gray-700 mb-2">
            <span class="font-semibold">License #{practice.medicalLicenseNumber}</span>
          </p>
          <p class="text-gray-600 text-sm mb-2">
            {practice.medicalLicenseStatus}
          </p>
          <p class="text-gray-600 text-xs">
            Expires {practice.licenseExpiresDate}
          </p>
        </div>

        {/* Languages */}
        <div class="bg-white rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            Languages
          </h3>
          <ul class="space-y-2">
            {practice.languages.map((lang) => (
              <li class="text-gray-700">
                <span class="inline-block mr-2">•</span>{lang}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Postgraduate Training Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-gray-900">
          Postgraduate Training
        </h2>
        <div class="bg-primary-50 border-l-4 border-primary-600 p-8 rounded-r-lg">
          <p class="text-gray-700 mb-3 leading-relaxed">
            <span class="font-semibold text-gray-900">{practice.education.postgraduateTraining}</span> in family medicine and internal medicine at <span class="font-semibold">{practice.education.residency}</span>, where Dr. Chang developed his clinical expertise and refined his patient-centered approach to comprehensive medical care.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Board Certifications Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        Board Certifications
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {practice.boardCertifications.map((cert) => (
          <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="text-3xl">✓</div>
              <div>
                <h3 class="font-serif text-xl font-bold text-gray-900">
                  {cert.specialty}
                </h3>
              </div>
            </div>
            <div class="space-y-3">
              <div>
                <p class="text-gray-600 text-sm">Board</p>
                <p class="text-gray-900 font-semibold">{cert.board}</p>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Initial Certification</p>
                <p class="text-gray-900">{cert.firstCertified}</p>
              </div>
              {cert.mostRecentCertification && (
                <div>
                  <p class="text-gray-600 text-sm">Most Recent Certification</p>
                  <p class="text-gray-900">{cert.mostRecentCertification}</p>
                </div>
              )}
              <div>
                <p class="text-gray-600 text-sm">Status</p>
                <p class="text-gray-900 font-semibold text-green-600">{cert.currentStatus}</p>
              </div>
              {cert.maintenanceRequired && (
                <div class="pt-2 border-t border-gray-200">
                  <p class="text-xs text-gray-600 italic">Maintenance of Certification (MOC) required</p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Hospital Affiliations Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-12 text-gray-900">
          Hospital Affiliations
        </h2>

        <div class="space-y-4">
          {practice.hospitalAffiliations.map((hospital) => (
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 flex items-start gap-4">
              <span class="text-2xl text-blue-600 flex-shrink-0">🏥</span>
              <div>
                <p class="text-gray-900 font-semibold text-lg">{hospital}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 p-6 bg-gray-50 rounded-lg border border-gray-200">
          <p class="text-gray-700">
            Dr. Chang maintains active affiliations with these esteemed healthcare institutions, ensuring access to comprehensive hospital services and consultation when needed for his patients.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Call to Action Section */}
  <section class="py-16 md:py-24 bg-primary-50">
    <div class="max-w-container mx-auto px-4 md:px-6 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6 text-gray-900">
        Schedule Your Appointment
      </h2>
      <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
        Experience compassionate, comprehensive family medicine care. Dr. Chang is accepting new patients and looks forward to becoming your trusted healthcare partner.
      </p>
      <CallButton text="Call Us Today" size="lg" />
    </div>
  </section>
</BaseLayout>
