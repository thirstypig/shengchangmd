---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';

const title = 'About Dr. Sheng Chang, M.D., Ph.D. | Board-Certified Family Physician';
const description = 'Learn about Dr. Sheng Chang, M.D., Ph.D., a board-certified family physician in San Gabriel, California, who has practised in the San Gabriel Valley since 1979 and served two terms on the Arcadia City Council.';
const canonicalUrl = new URL('/about/', Astro.site).href;
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
>
  {/* Hero Section */}
  <HeroSection
    headline="About Dr. Sheng Chang, M.D., Ph.D."
    subheadline="A board-certified family physician who has cared for patients in the San Gabriel Valley since 1979, and served the City of Arcadia for two terms on its city council."
    locale="en"
    image="/images/dr-sheng-chang.jpg"
    imageAlt="Portrait of Dr. Sheng Chang"
    imageCaption="Board-Certified Family Physician"
  />

  {/* Bio Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-gray-900">
          Professional Background
        </h2>
        <div class="prose prose-lg text-gray-700 space-y-6">
          <p class="leading-relaxed">
            Dr. Sheng Chang moved to California in 1979 and settled in Arcadia, where he has practised as a family physician serving the Greater San Gabriel Valley ever since. He is board-certified by the American Board of Family Medicine and is a USCIS-designated civil surgeon.
          </p>
          <p class="leading-relaxed">
            At Garfield Medical Center, Dr. Chang served as Chair of the Department of Family Practice, later as Chief of Staff, and as a member of the hospital's governing board.
          </p>
          <p class="leading-relaxed">
            Dr. Chang has remained active in the National Taiwan University Medical College Alumni Association, serving as president of both the local chapter and the national organisation. In 2001 he organised the association's national event at Disneyland.
          </p>
          <p class="leading-relaxed">
            He is also a writer. In 2023 he published a book, <em>Endless Talk</em>.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Community & Public Service Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-gray-900">
          Community &amp; Public Service
        </h2>
        <div class="prose prose-lg text-gray-700 space-y-6">
          <p class="leading-relaxed">
            In 1982, Dr. Chang and his wife, <a
              href="https://minmeychang.com"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">Min Mey Chang</a>, founded the Arcadia Chinese Association to help new immigrants — most of them from Taiwan — who did not yet speak English well. The association also helps the immigrant community communicate with the Arcadia city government and the school district.
          </p>
          {/*
            The two "first Chinese-American" claims below are the only facts on
            this page sourced to a public archive rather than to the owner. Both
            come from the Arcadia Weekly, indexed by the Arcadia Public Library's
            Arcadia History Collection, and each is linked to its own permalink.

            Deep links only, by the owner's decision on 2026-08-05. Do NOT link
            the collection's search results for "Sheng Chang": the same 57-record
            run also indexes a 2003 embezzlement accusation (which he denied and
            sued over, and for which the archive records no outcome) and a 1994
            election-fraud suit that a judge dismissed. Linking the search would
            put those one click from a patient and give crawlers a path to them.

            newspaper31226 also calls him Arcadia's first Asian-American mayor.
            That is left off the page deliberately — it is a broader claim
            resting on a single sentence, and the Chinese-American framing is
            supported by both records independently.
          */}
          <p class="leading-relaxed">
            In 1994, Dr. Chang ran for the Arcadia City Council in order to serve the immigrant community and the city as a whole. He was elected to two terms, from 1994 to 1998 and from 2000 to 2004, becoming <a
              href="https://arcadiahistory.andornot.net/en/permalink/newspaper31226"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">the first Chinese-American to serve on the Arcadia City Council</a>. He served as rotating mayor from April to July 2003, Arcadia's centennial year, and was honoured as <a
              href="https://arcadiahistory.andornot.net/en/permalink/newspaper31744"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">the city's first Chinese-American mayor</a>.
          </p>
          <p class="leading-relaxed">
            During his years on the council, he was influential in the <a
              href="https://arcadiahistory.andornot.net/en/permalink/photographs1491"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">renovation of the Arcadia Public Library</a> and a strong supporter of the new Arcadia police headquarters.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Credentials & Languages Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        Credentials &amp; Professional Information
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {/* Medical Degree */}
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            Medical Degree
          </h3>
          <p class="text-gray-700 mb-2">
            <span class="font-semibold">{practice.education.medicalDegree}</span>
          </p>
          <p class="text-gray-600 text-sm mb-2">
            {practice.education.school}
          </p>
          <p class="text-gray-600 text-sm">
            Graduated {practice.education.year}
          </p>
          <ul class="mt-4 space-y-2 border-t border-gray-200 pt-4">
            {practice.education.postgraduateTraining.map((t) => (
              <li class="text-gray-600 text-sm">{t}</li>
            ))}
          </ul>
        </div>

        {/* Languages */}
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            Languages
          </h3>
          <ul class="space-y-2">
            {practice.languages.map((lang) => (
              <li class="text-gray-700">
                <span class="inline-block mr-2">•</span>{lang}
              </li>
            ))}
          </ul>
        </div>

        {/* Medical Licence */}
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            California Medical Licence
          </h3>
          <p class="text-gray-700 mb-2">
            <span class="font-semibold">{practice.medicalLicenseNumber}</span>
          </p>
          <p class="text-gray-600 text-sm">
            {practice.medicalLicenseStatus}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Board Certifications Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        Board Certifications
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {practice.boardCertifications.map((cert) => (
          <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
            <div class="flex items-start gap-4 mb-4">
              <div class="text-3xl" aria-hidden="true">✓</div>
              <div>
                <h3 class="font-serif text-xl font-bold text-gray-900">
                  {cert.specialty}
                </h3>
              </div>
            </div>
            <div class="space-y-3">
              <div>
                <p class="text-gray-600 text-sm">Board</p>
                <p class="text-gray-900 font-semibold">{cert.board}</p>
              </div>
              <div>
                <p class="text-gray-600 text-sm">Initial Certification</p>
                <p class="text-gray-900">{cert.firstCertified}</p>
              </div>
              {cert.mostRecentCertification && (
                <div>
                  <p class="text-gray-600 text-sm">Most Recent Certification</p>
                  <p class="text-gray-900">{cert.mostRecentCertification}</p>
                </div>
              )}
              <div>
                <p class="text-gray-600 text-sm">Status</p>
                <p class="text-gray-900 font-semibold text-success">{cert.currentStatus}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Call to Action Section */}
  <section class="py-16 md:py-24 bg-primary-50">
    <div class="max-w-container mx-auto px-4 md:px-6 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6 text-gray-900">
        Schedule Your Appointment
      </h2>
      <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
        Experience compassionate, comprehensive family medicine care. Dr. Chang is accepting new patients and looks forward to becoming your trusted healthcare partner.
      </p>
      <CallButton text="Call Us Today" size="lg" />
    </div>
  </section>
</BaseLayout>
