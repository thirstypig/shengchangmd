---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = 'Accessibility Statement | Sheng Chang, M.D.';
const description = 'Accessibility statement for the practice website of Sheng Chang, M.D.';
const canonicalUrl = new URL('/accessibility/', Astro.site).href;
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
>
  <h1>Accessibility Statement</h1>
  <p>Coming soon.</p>
</BaseLayout>
