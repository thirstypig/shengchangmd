---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslation } from '@i18n/locales';
import '../../styles/pages/hours.css';

/*
 * Mirrors src/pages/hours.astro. Until 2026-08-20 that page existed only in
 * English while BaseLayout advertised zh-Hant and zh-Hans alternates for it,
 * both of which 404'd.
 *
 * The hours themselves come from getTranslation, never practice.hours — those
 * are English strings ("Monday–Friday 9:00 AM – 1:00 PM") and interpolating
 * them here would switch language mid-page.
 */

const locale = 'zh-hant';
const title = '門診時間 | 張勝雄醫師 | 加州聖蓋博';
const description = `加州聖蓋博張勝雄醫師家庭醫學診所的門診時間：${getTranslation(locale, 'hoursWeekday')}，${getTranslation(locale, 'hoursWeekend')}。`;
const canonicalUrl = new URL('/zh-hant/hours/', Astro.site).href;

const breadcrumbs = [
  { label: getTranslation(locale, 'home'), href: '/zh-hant/' },
  { label: getTranslation(locale, 'footer.hours'), href: '/zh-hant/hours/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <section class="content-section">
    <div class="content-left">
      <h1>門診時間</h1>
      <div class="hours-list">
        <div class="hours-item">
          <span>{getTranslation(locale, 'hoursWeekday')}</span>
        </div>
        <div class="hours-item">
          <span>{getTranslation(locale, 'hoursWeekend')}</span>
        </div>
      </div>
      <p class="hours-note">
        門診時間以外來電，請留言。我們會於下一個工作日回覆。
      </p>
    </div>
  </section>
</BaseLayout>
