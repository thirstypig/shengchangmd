---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';
import { getTranslation } from '@i18n/locales';
import '../../styles/pages/insurance.css';

const title = '保險與支付 | 張勝雄醫師 | 加州聖蓋博';
const description = '加州聖蓋博張勝雄醫師診所的保險與費用說明。歡迎來電，我們會與您確認保險給付與就診費用。';
const canonicalUrl = new URL('/zh-hant/insurance/', Astro.site).href;
const locale = 'zh-hant';

const breadcrumbs = [
  { label: getTranslation('zh-hant', 'home'), href: '/zh-hant/' },
  { label: getTranslation('zh-hant', 'insurance'), href: '/zh-hant/insurance/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale="zh-hant"
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1>保險與支付</h1>
      <p class="hero-subtitle">歡迎來電，我們會與您確認保險給付與費用</p>
    </div>
  </section>

  <!-- Accepted Plans Section -->
  <section class="content-section">
    <div class="content-container">
      <div class="content-left">
        <h2>保險與費用</h2>
        <h3 class="coverage-heading">{getTranslation(locale, 'coverage.heading')}</h3>
        <ul class="coverage-list">
          <li>{getTranslation(locale, 'coverage.medicare')}</li>
          <li>{getTranslation(locale, 'coverage.mediCal')}</li>
          <li>{getTranslation(locale, 'coverage.hmo')}</li>
          <li>{getTranslation(locale, 'coverage.ppo')}</li>
          <li>{getTranslation(locale, 'coverage.privateInsurance')}</li>
          <li>{getTranslation(locale, 'coverage.cash')}</li>
        </ul>
        <p class="note">
          {getTranslation(locale, 'coverage.confirmNote')}
        </p>
        <p>
          請留意，移民體檢、公民入籍考試豁免醫療評估報告及醫療法律報告，通常不在健康保險的給付範圍內，因為這些屬於行政用途而非治療。來電時請一併詢問，我們會告知您本次就診的費用。
        </p>
        <p class="note">
          <strong>來電時請備妥您的保險卡。</strong> 診所電話：<a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`}>{practice.phone}</a>。
        </p>
        {/*
          A fabricated carrier list and three invented payment claims stood in
          this page. See the English source at src/pages/insurance.astro for the
          full account. Nothing here may name a carrier or promise a billing or
          payment term until the practice supplies them.

          UPDATE 2026-08-06. The list above names plan TYPES, not carriers, and
          is published on the owner's written instruction. The confirmNote is
          load-bearing: HMO and PPO are plan structures, not networks. The
          prohibition on carrier names, carrier logos and "most major plans"
          phrasing is unchanged.
        */}
      </div>
      <div class="content-right">
        <div class="info-box">
          <h3>確認您的保險給付</h3>
          <p>
            就診前請先來電本診所，我們會為您確認保險給付、自付額，以及是否需要事前授權。
          </p>
          <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="cta-button">
            來電確認給付
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Payment Options Section -->
  <section class="payment-section">
    <h2>支付選項</h2>
    <div class="payment-grid">
      <div class="payment-card">
        <h3>就診前</h3>
        <p>
          請致電診所，提供您的保險資料並告知您要預約的服務項目。我們會告訴您哪些項目有給付，以及您預計需要支付的金額。
        </p>
      </div>
      <div class="payment-card">
        <h3>自費就診</h3>
        <p>
          許多患者選擇自費，移民與各類報告服務尤其如此。請於來電時詢問費用，以免當天出現預期之外的支出。
        </p>
      </div>
    </div>
  </section>

  <!-- Questions Section -->
  <section class="questions-section">
    <div class="questions-content">
      <h2>有關保險或帳單的問題？</h2>
      <p>
        {/*
          Was "本診所工作人員熟悉保險事務，樂意為您解答…" — an assertion that the
          staff are knowledgeable about insurance, which the English source has
          never claimed. A competence claim nobody supplied is the same class of
          problem as the fabricated carrier list, just smaller. Now matches the
          English: call, and we will go through it with you.
        */}
        歡迎來電，我們會與您說明保險給付、帳單與就診費用。
      </p>
      <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="cta-button-large">
        立即致電我們
      </a>
      <p class="contact-info">
        {practice.phone} | {getTranslation('zh-hant', 'hoursWeekday')}
      </p>
    </div>
  </section>
</BaseLayout>
