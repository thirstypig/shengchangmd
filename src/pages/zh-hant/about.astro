---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';
import { getPracticeLocalized, getTranslation } from '@i18n/locales';

const title = '關於張勝雄醫師（M.D., Ph.D.） | 美國家庭醫學專科醫師';
const description = '了解張勝雄醫師，美國家庭醫學專科醫師，自 1979 年起在加州聖蓋博谷地區執業，並曾擔任兩屆 Arcadia 市議員。';
const pl = getPracticeLocalized('zh-hant');
const canonicalUrl = new URL('/zh-hant/about/', Astro.site).href;

/*
  美國機構與組織名稱刻意保留英文 — see the convention recorded in
  src/i18n/locales.ts: an entity keeps its English name unless it has a real
  name in the target language that readers would expect. Arcadia Chinese
  Association, Garfield Medical Center and the Arcadia institutions below have
  Chinese names in local usage, but none of them were supplied by the owner and
  guessing at the characters would invent a name. Left in English until he
  confirms them.

  This biography was translated here without a native reviewer. Both Chinese
  locales are `reviewed: false` in locales.ts, so every page in them renders
  noindex — that gate is what makes this safe to ship. Do not flip `reviewed`
  for zh-hant until a fluent reader has checked this page.
*/
---

<BaseLayout
  title={title}
  description={description}
  locale="zh-hant"
  canonicalUrl={canonicalUrl}
>
  {/* Hero Section */}
  <HeroSection
    headline="關於張勝雄醫師（M.D., Ph.D.）"
    subheadline="美國家庭醫學專科醫師，自 1979 年起照護聖蓋博谷地區的患者，並曾擔任兩屆 Arcadia 市議員。"
    locale="zh-hant"
    image="/images/dr-sheng-chang.jpg"
    imageAlt="張勝雄醫師肖像"
    imageCaption="美國家庭醫學專科醫師"
  />

  {/* Bio Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-gray-900">
          專業背景
        </h2>
        <div class="prose prose-lg text-gray-700 space-y-6">
          {/*
            Early life supplied by the owner 2026-08-06. Publish NO number of
            years in practice — see the English source at src/pages/about.astro
            for why. His sons and grandsons are deliberately absent.
            國立臺灣大學醫學院 is taken from practiceLocalized.school rather than
            written out again, so the institution's name lives in one place.
          */}
          <p class="leading-relaxed">
            張醫師成長於臺灣臺南，1967 年畢業於{pl.school}。他於 1968 年與夫人 Min Mey Chang 結婚，並於 1969 年赴美。
          </p>
          <p class="leading-relaxed">
            張勝雄醫師於 1979 年移居加州，定居 Arcadia，此後一直在大聖蓋博谷地區從事家庭醫學診療。他通過美國家庭醫學專科醫師認證，並獲美國公民及移民服務局（USCIS）指定為體檢醫師。
          </p>
          <p class="leading-relaxed">
            張醫師曾在 Garfield Medical Center 擔任家庭醫學科主任，其後出任醫務長（Chief of Staff），並曾為該院董事會成員。
          </p>
          <p class="leading-relaxed">
            張醫師長期活躍於{pl.school}校友會，曾任該會地方分會會長及全國總會會長。2001 年，他在迪士尼樂園主辦了該會的全國性活動。
          </p>
          <p class="leading-relaxed">
            他也喜愛寫作，並於 2023 年出版《Endless Talk》一書。
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Community & Public Service Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-4xl font-bold mb-8 text-gray-900">
          社區與公共服務
        </h2>
        <div class="prose prose-lg text-gray-700 space-y-6">
          <p class="leading-relaxed">
            1982 年，張醫師與夫人 <a
              href="https://minmeychang.com"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">Min Mey Chang</a> 共同創辦了 Arcadia Chinese Association，協助多來自臺灣、英語尚不流利的新移民。他自 1982 年至 1990 年擔任創會會長。該協會也協助移民社區與 Arcadia 市政府及學區溝通。
          </p>
          {/*
            兩項「首位華裔」記載出自 Arcadia Weekly，由 Arcadia 公共圖書館的
            Arcadia History Collection 收錄。Deep links only — see the full
            rationale in the English source at src/pages/about.astro, including
            why the collection's search results must never be linked.
          */}
          <p class="leading-relaxed">
            1994 年，張醫師競選 Arcadia 市議員，期望能為移民社區以及整個城市提供更好的服務。他當選並擔任兩屆市議員，任期分別為 1994 至 1998 年及 2000 至 2004 年，成為 <a
              href="https://arcadiahistory.andornot.net/en/permalink/newspaper31226"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">Arcadia 市議會首位華裔議員</a>。他並於 2003 年 4 月至 7 月間，即 Arcadia 建市百週年之際擔任輪值市長，並經記載為<a
              href="https://arcadiahistory.andornot.net/en/permalink/newspaper31744"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">該市首位華裔市長</a>。
          </p>
          <p class="leading-relaxed">
            在市議會任職期間，他對 <a
              href="https://arcadiahistory.andornot.net/en/permalink/photographs1491"
              class="text-primary-700 underline underline-offset-2 hover:no-underline"
              target="_blank"
              rel="noopener noreferrer">Arcadia 公共圖書館的整修</a>扮演了重要角色，並大力支持新建的 Arcadia 警察總部。
          </p>
        </div>
        <div class="mt-10">
          <h3 class="font-semibold text-lg text-gray-900 mb-2">
            {getTranslation('zh-hant', 'communityPhotos.heading')}
          </h3>
          <p class="text-gray-600 mb-4">
            {getTranslation('zh-hant', 'communityPhotos.intro')}
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <a href="/images/recognition/banquet-speech-1987.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/banquet-speech-1987.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo5')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/la-county-commendation-1988.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/la-county-commendation-1988.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo2')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/speech-arcadia-new-year.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/speech-arcadia-new-year.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo14')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/city-council-chambers-1.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/city-council-chambers-1.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo11')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/city-council-chambers-2.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/city-council-chambers-2.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo12')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/library-groundbreaking.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/library-groundbreaking.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo10')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/police-hq-groundbreaking.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/police-hq-groundbreaking.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo9')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/congressional-proclamation-1988.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/congressional-proclamation-1988.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo1')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/certificate-of-commendation-1988.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/certificate-of-commendation-1988.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo3')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/speech-ntu-alumni.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/speech-ntu-alumni.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo15')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/alumni-certificate-2005.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/alumni-certificate-2005.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo4')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/welcome-delegation.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/welcome-delegation.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo6')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/plaque-presentation-1989.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/plaque-presentation-1989.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo7')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/culture-symposium.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/culture-symposium.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo8')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/press-clipping-culture-center.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/press-clipping-culture-center.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo13')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/press-clipping-doctor-helps-immigrants.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/press-clipping-doctor-helps-immigrants.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo16')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
            <a href="/images/recognition/press-clipping-aauw.jpg" target="_blank" rel="noopener noreferrer">
              <img src="/images/recognition/press-clipping-aauw.jpg" alt={getTranslation('zh-hant', 'communityPhotos.photo17')} class="w-full h-48 sm:h-56 object-contain bg-white rounded-lg border border-gray-200" loading="lazy" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Credentials & Languages Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        執業資格與專業資訊
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {/* Medical Degree */}
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            醫學學位
          </h3>
          <p class="text-gray-700 mb-2">
            <span class="font-semibold">{practice.education.medicalDegree}</span>
          </p>
          <p class="text-gray-600 text-sm mb-2">
            {pl.school}
          </p>
          <p class="text-gray-600 text-sm">
            {practice.education.year} 年畢業
          </p>
          {/*
            用語待確認：住院醫師訓練機構名稱暫以英文呈現。「University of Alabama
            Medical Center」等機構在此無通行的中文名稱，自行翻譯等同捏造。
            See the note in src/i18n/locales.ts. Revisit with a fluent reader.
          */}
          <ul class="mt-4 space-y-2 border-t border-gray-200 pt-4">
            {practice.education.postgraduateTraining.map((t) => (
              <li class="text-gray-600 text-sm">{t}</li>
            ))}
          </ul>
        </div>

        {/* Languages */}
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            語言
          </h3>
          <ul class="space-y-2">
            {pl.languages.map((lang) => (
              <li class="text-gray-700">
                <span class="inline-block mr-2">•</span>{lang}
              </li>
            ))}
          </ul>
        </div>

        {/* Medical License */}
        <div class="bg-gray-50 rounded-lg p-8 border border-gray-200">
          <h3 class="font-serif text-xl font-bold mb-4 text-gray-900">
            加州醫師執照
          </h3>
          <p class="text-gray-700 mb-2">
            <span class="font-semibold">{practice.medicalLicenseNumber}</span>
          </p>
          <p class="text-gray-600 text-sm">
            {pl.licenseStatus[practice.medicalLicenseStatus] ?? practice.medicalLicenseStatus}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Board Certifications Section */}
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        專科認證
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        {practice.boardCertifications.map((cert) => (
          <div class="bg-white rounded-lg p-8 border border-gray-200 shadow-sm">
            <div class="flex items-start gap-4 mb-4">
              <div class="text-3xl" aria-hidden="true">✓</div>
              <div>
                <h3 class="font-serif text-xl font-bold text-gray-900">
                  {pl.specialties[cert.specialty] ?? cert.specialty}
                </h3>
              </div>
            </div>
            <div class="space-y-3">
              <div>
                <p class="text-gray-600 text-sm">認證機構</p>
                <p class="text-gray-900 font-semibold">{pl.boards[cert.board] ?? cert.board}</p>
              </div>
              <div>
                <p class="text-gray-600 text-sm">首次認證</p>
                <p class="text-gray-900">{cert.firstCertified}</p>
              </div>
              {cert.mostRecentCertification && (
                <div>
                  <p class="text-gray-600 text-sm">最近認證</p>
                  <p class="text-gray-900">{cert.mostRecentCertification}</p>
                </div>
              )}
              <div>
                <p class="text-gray-600 text-sm">狀態</p>
                <p class="text-gray-900 font-semibold text-success">{pl.certStatus[cert.currentStatus] ?? cert.currentStatus}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Call to Action Section */}
  <section class="py-16 md:py-24 bg-primary-50">
    <div class="max-w-container mx-auto px-4 md:px-6 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-6 text-gray-900">
        預約您的就診
      </h2>
      <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
        {/*
          Reworded 2026-08-09. The previous version was a literal rendering of
          the English marketing copy and did not survive contact with Taiwanese
          usage: 護理 means NURSING specifically, so 家庭醫學護理 read as "family
          medicine nursing"; 合作夥伴 is a business term, so 醫療保健合作夥伴 read
          as a commercial partnership; and 富有同情心 is a calque of
          "compassionate" where 同情心 means pity, which is faintly
          condescending toward the patient.
        */}
        張醫師現正接受新患者，提供完整的家庭醫學照護，細心傾聽每一位患者的需求，長期為您與家人守護健康。
      </p>
      <CallButton text="立即致電我們" size="lg" />
    </div>
  </section>
</BaseLayout>
