---
import BaseLayout from '@layouts/BaseLayout.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';
import { getTranslation } from '@i18n/locales';

const title = '聯絡我們 | 張勝雄醫師';
const description = '聯絡張勝雄醫師診所。加州聖蓋博，歡迎來電或以電子郵件聯絡，亦可親自到診。';
const canonicalUrl = new URL('/zh-hant/contact/', Astro.site).href;
---

<BaseLayout
  title={title}
  description={description}
  locale="zh-hant"
  canonicalUrl={canonicalUrl}
>
  {/* Hero Section */}
  <section class="bg-gradient-to-b from-primary-50 to-white py-12 md:py-20">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        聯絡我們
      </h1>
      <p class="text-xl text-gray-700 leading-relaxed max-w-2xl">
        有問題或想預約嗎？歡迎直接來電，我們會盡快為您安排。
      </p>
    </div>
  </section>

  {/* Contact Content Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">

        {/* Left Column: Call & Visit Info */}
        <div class="space-y-12">

          {/* Call Us Section */}
          <div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-6">
              致電我們
            </h2>
            <p class="text-gray-600 mb-4">
              {/*
                通過 in Taiwan usage means "to pass" (a test, a law). "Via
                phone" is 透過, but the sentence reads better without it.
                Note 通過...認證 elsewhere on this page IS correct - that is
                "passed certification" - so do not sweep for the word.
              */}
              來電是最快的聯絡方式。我們很樂意回答您的問題並為您安排預約。
            </p>
            <a href={`tel:+1${practice.phone.replace(/\D/g, '')}`} class="inline-block">
              <div class="text-2xl md:text-3xl font-bold text-primary-600 hover:text-primary-700 transition-colors mb-6">
                {practice.phone}
              </div>
            </a>
            <CallButton text="立即致電" size="base" />
          </div>

          {/* Visit Us Section */}
          <div>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-6">
              親自到診
            </h2>

            <div class="mb-6">
              <h3 class="font-semibold text-gray-900 mb-2">辦公室地址</h3>
              <p class="text-gray-700 leading-relaxed">
                {practice.address}
              </p>
            </div>

            <div class="mb-6">
              <h3 class="font-semibold text-gray-900 mb-2">門診時間</h3>
              <p class="text-gray-700 mb-2">
                <strong>工作日：</strong> {getTranslation('zh-hant', 'hoursWeekday')}
              </p>
              <p class="text-gray-700">
                <strong>週末：</strong> {getTranslation('zh-hant', 'hoursWeekend')}
              </p>
            </div>

            <a
              href="https://maps.google.com/?q=330+W.+Las+Tunas+Drive,+Suite+3,+San+Gabriel,+CA+91776"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition-colors"
            >
              查看路線
            </a>
          </div>
        </div>

        {/* Right Column: how to reach the office — see src/pages/contact.astro */}
        <div>
          <h2 class="font-serif text-2xl md:text-3xl font-bold text-gray-900 mb-6">
            如何聯絡診所
          </h2>
          <p class="text-gray-600 mb-8">
            預約與一般諮詢請直接來電。非緊急事項也可以電子郵件聯絡，但來電通常較快。
          </p>

          <div class="space-y-4">
            <a
              href={`tel:+1${practice.phone.replace(/\D/g, '')}`}
              class="block w-full text-center px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition-colors"
            >
              致電 {practice.phone}
            </a>
            <a
              href={`mailto:${practice.email}`}
              class="block w-full text-center px-8 py-4 border border-primary-600 text-primary-700 font-semibold rounded-lg hover:bg-primary-50 transition-colors"
            >
              電子郵件 {practice.email}
            </a>
            <div class="bg-primary-50 border border-primary-200 rounded-lg p-4 text-sm text-gray-700">
              <p>緊急事項請勿使用電子郵件。若為醫療緊急狀況，請撥打 911。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

