---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';

const title = `${practice.doctorName} | 經過認證的家庭醫學醫生 | 聖蓋博，加州`;
const description = `經過認證的家庭醫學醫生在聖蓋博，加州。張醫生提供全面的家庭醫學和內科服務。現在接受新患者。`;
const canonicalUrl = 'https://shengchangmd.com/zh-hant/';
---

<BaseLayout
  title={title}
  description={description}
  locale="zh-hant"
  canonicalUrl={canonicalUrl}
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-container">
      <div class="hero-image">
        <div class="portrait-placeholder">照片</div>
      </div>

      <div class="hero-content">
        <h1 class="doctor-name">張勝雄 醫師</h1>
        <p class="doctor-subtitle-en">Sheng Chang, M.D.</p>
        <p class="doctor-subtitle">
          家庭醫學科 · 聖蓋博 · 國語與英語
        </p>

        <div class="hero-cta">
          <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="cta-button cta-primary">
            電話 {practice.phone}
          </a>
          <a href="/zh-hant/new-patients/" class="cta-button cta-secondary">
            預約掛號
          </a>
        </div>

        <div class="hero-quick-info">
          <div class="info-item">
            <div class="info-label">門診時間</div>
            <div class="info-value">週一至週五 9:00 AM – 5:00 PM</div>
          </div>
          <div class="info-item">
            <div class="info-label">位置</div>
            <div class="info-value">聖蓋博，加州</div>
          </div>
          <div class="info-item">
            <div class="info-label">保險</div>
            <a href="/zh-hant/insurance/" class="info-link">查看保險計畫</a>
          </div>
          <div class="info-item">
            <div class="info-label">新患者</div>
            <div class="info-value">接受掛號</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="content-section">
    <div class="content-container">
      <div class="content-left">
        <h2>認識您全家的家庭醫師</h2>
        <p>
          張醫生自1960年代後期起，即開始在聖蓋博谷地照顧家庭患者，服務地點始終是位在Las Tunas Drive的同一間診所。
          自1979年起獲得美國家庭醫學委員會認證，擁有豐富的臨床經驗，致力於為每位患者及其家庭提供個人化、細心周到的醫療照護。
        </p>
      </div>
      <div class="content-right">
        <div class="info-box">
          <h3>醫學認證</h3>
          {
            practice.boardCertifications.map((cert) => (
              <div class="cert-item">
                <p class="cert-specialty"><strong>{cert.specialty}</strong></p>
                <p class="cert-detail">{cert.board}</p>
                <p class="cert-detail">認證年份 {cert.firstCertified}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  html[lang="zh-Hant"] body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans TC', sans-serif;
    font-size: 1.06rem;
    line-height: 1.85;
    letter-spacing: 0.02em;
  }

  html[lang="zh-Hant"] main {
    max-width: 24em;
  }

  /* Hero Section */
  .hero {
    padding: 2rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
    border-bottom: 2px solid #e5e5e5;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    align-items: flex-start;
  }

  .hero-image {
    flex-shrink: 0;
  }

  .portrait-placeholder {
    width: 250px;
    height: 350px;
    background-color: #f5f5f5;
    border: 1px solid #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    color: #999;
    border-radius: 2px;
  }

  .hero-content {
    padding: 0;
  }

  .doctor-name {
    font-size: 2.5rem;
    margin: 0 0 0.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .doctor-subtitle-en {
    font-size: 1rem;
    color: #666;
    margin: 0 0 0.5rem;
    font-weight: 500;
  }

  .doctor-subtitle {
    font-size: 1.125rem;
    color: #666;
    margin: 0 0 1.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .cta-button {
    padding: 0.75rem 1.5rem;
    border-radius: 2px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    font-size: 1rem;
    transition: all 0.2s;
    border: 2px solid;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
  }

  .cta-primary {
    background: #3d2b52;
    color: #fff;
    border-color: #3d2b52;
  }

  .cta-primary:hover {
    background: #2d1b42;
    border-color: #2d1b42;
  }

  .cta-secondary {
    background: white;
    color: #3d2b52;
    border-color: #3d2b52;
  }

  .cta-secondary:hover {
    background: #f5f5f5;
  }

  .hero-quick-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e5e5;
  }

  .info-item {
    font-size: 0.95rem;
  }

  .info-label {
    font-weight: 600;
    color: #666;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .info-value {
    color: #1a1a1a;
    font-size: 1rem;
  }

  .info-link {
    color: #4a3f6b;
    text-decoration: none;
    font-weight: 600;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  /* Content Sections */
  .content-section {
    padding: 2rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
    border-bottom: 1px solid #e5e5e5;
  }

  .content-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .content-left h2 {
    font-size: 2rem;
    margin: 0 0 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .content-left p {
    font-size: 1rem;
    line-height: 1.8;
    color: #333;
    margin: 0;
  }

  .info-box {
    background-color: #f9f9f9;
    padding: 1.5rem;
    border-radius: 2px;
    border-left: 4px solid #4a3f6b;
  }

  .info-box h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cert-item {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
  }

  .cert-item:last-child {
    border-bottom: none;
  }

  .cert-specialty {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .cert-detail {
    font-size: 0.875rem;
    color: #666;
    margin: 0.25rem 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
    }

    .portrait-placeholder {
      width: 100%;
      height: 250px;
    }

    .doctor-name {
      font-size: 2rem;
    }

    .hero-quick-info {
      grid-template-columns: 1fr;
    }

    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .content-left h2 {
      font-size: 1.5rem;
    }
  }
</style>
