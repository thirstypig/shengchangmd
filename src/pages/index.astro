---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';

const locale = 'en';
const title = `${practice.doctorName} | Board-Certified Family Physician | San Gabriel, CA`;
const description = `Board-certified family physician and USCIS-designated civil surgeon in San Gabriel, California. Immigration medical services, citizenship exam waiver reports, medical-legal reports, stem cell therapy, and family medicine.`;
const canonicalUrl = new URL('/', Astro.site).href;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
>
  {/* Hero Section */}
  <HeroSection
    headline="Meet Dr. Sheng Chang, M.D."
    subheadline="Family medicine serving San Gabriel and surrounding communities. Board-certified, compassionate, and dedicated to your health."
    locale={locale}
    image="/images/dr-sheng-chang.jpg"
    imageAlt="Portrait of Dr. Sheng Chang, M.D."
    imageCaption="Board-Certified Family Physician"
  />

  {/* Services Section */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        Our Services
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ServiceCard
          icon="document"
          title="Immigration Medical Services"
          description="Form I-693 completed and sealed by a USCIS-designated civil surgeon, including required screenings and vaccination review."
          href="/services/#immigration-exams"
        />
        <ServiceCard
          icon="shield"
          title="Citizenship Exam Waiver Medical Evaluation Report"
          description="Form N-648 certification for naturalisation applicants who cannot meet the English or civics requirements for medical reasons."
          href="/services/#citizenship-waiver"
        />
        <ServiceCard
          icon="chart"
          title="Medical-Legal Reports"
          description="Written medical reports and evaluations prepared for legal and administrative matters."
          href="/services/#medical-legal"
        />
        <ServiceCard
          icon="stethoscope"
          title="Stem Cell Therapy"
          description="Stem cell therapy is offered at the San Gabriel office. Call to discuss whether it is appropriate for your situation."
          href="/services/#stem-cell-therapy"
        />
        <ServiceCard
          icon="family"
          title="Family Medicine"
          description="Continuing care for patients of all ages, from preventive health to acute illness treatment."
          href="/services/#family-medicine"
        />
      </div>
    </div>
  </section>

  {/*
    The "Why Trust Dr. Chang?" section was removed 2026-08-05 at the owner's
    request, along with its "Board Certified", "Experience" and hospital
    affiliations blocks. Two things went with it that he did not name: the
    languages list and the "Accepting New Patients" badge. Languages still
    appear on the About page; the accepting-new-patients state still drives
    `acceptsNewPatients` in the JSON-LD. Re-add a slim strip here if either is
    wanted back on the homepage.
  */}

  {/* Quick Contact CTA */}
  <section class="py-16 md:py-24 bg-primary-50">
    <div class="max-w-container mx-auto px-4 md:px-6 text-center">
      <h2 class="font-serif text-3xl font-bold mb-6 text-gray-900">
        Ready to Schedule Your Visit?
      </h2>
      <p class="text-lg text-gray-700 mb-8">
        Call us today to book your appointment or learn more about our services.
      </p>
      <CallButton text="Call Us Now" size="lg" />
    </div>
  </section>
</BaseLayout>
