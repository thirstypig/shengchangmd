---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';
import { getPracticeLocalized, getTranslation } from '@i18n/locales';

const locale = 'zh-hans';
const t = (key: string) => getTranslation(locale, key);
const pl = getPracticeLocalized(locale);
const title = `${practice.doctorName} | 家庭医学专科医师 | 加州圣盖博`;
const description = `加州圣盖博的家庭医学专科医师，并为美国移民局指定体检医师。提供移民医疗服务、公民入籍考试豁免医疗评估报告、医疗法律报告、干细胞治疗与家庭医学。`;
const canonicalUrl = new URL('/zh-hans/', Astro.site).href;
---

<BaseLayout {title} {description} {locale} {canonicalUrl}>
  <HeroSection
    headline="张胜雄医师（M.D.）"
    subheadline="于圣盖博谷及邻近社区提供家庭医学诊疗，具家庭医学专科医师资格，看诊细心，以您的健康为念。"
    {locale}
    media="chop"
  />

  {/* 诊疗项目 */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        诊疗项目
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ServiceCard
          icon="document"
          title={t(`serviceCards.immigrationExams`)}
          description="由美国移民局指定体检医师填写并密封 Form I-693，包含必要筛检与疫苗纪录审核。"
          href="/zh-hans/services/#immigration-exams"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="shield"
          title={t(`serviceCards.citizenshipWaiver`)}
          description="为因医疗原因无法符合英语或公民常识考试要求的入籍申请人填写 Form N-648。"
          href="/zh-hans/services/#citizenship-waiver"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="chart"
          title={t(`serviceCards.medicalLegal`)}
          description="为法律及行政程序撰写医疗报告与评估。"
          href="/zh-hans/services/#medical-legal"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="stethoscope"
          title={t(`serviceCards.stemCell`)}
          description="本诊所提供干细胞治疗。欢迎致电了解是否适合您的情况。"
          href="/zh-hans/services/#stem-cell-therapy"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="family"
          title={t(`serviceCards.familyMedicine`)}
          description="为成人患者提供持续照护，从预防保健到急性病症治疗。"
          href="/zh-hans/services/#family-medicine"
          linkLabel="了解更多"
        />
      </div>
    </div>
  </section>

  {/* 语言与新患者 — see the note in src/pages/index.astro */}
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-center gap-8 md:gap-16">
        <div class="text-center md:text-left">
          <h2 class="font-serif text-xl font-bold mb-3 text-gray-900">看诊语言</h2>
          <p class="text-lg text-gray-700">{pl.languages.join(' · ')}</p>
        </div>
        {practice.acceptingNewPatients && (
          <div class="bg-white border border-success rounded-lg px-6 py-4 text-center">
            <p class="text-success font-semibold">
              <span aria-hidden="true">✓</span> 现正接受新患者
            </p>
          </div>
        )}
      </div>
      {/* 看诊对象 — qualifies the badge above. See src/pages/index.astro. */}
      <p class="mt-6 text-center text-gray-700">
        {t(`patientScope.summary`)}{' '}
        <a
          href="/zh-hans/services/#who-we-see"
          class="text-primary-700 underline underline-offset-2 hover:no-underline"
          >{t(`patientScope.linkLabel`)}</a
        >
      </p>
    </div>
  </section>

  {/* 预约 */}
  <section class="py-16 md:py-24 bg-primary-50">
    <div class="max-w-container mx-auto px-4 md:px-6 text-center">
      <h2 class="font-serif text-3xl font-bold mb-6 text-gray-900">准备预约看诊？</h2>
      <p class="text-lg text-gray-700 mb-8">
        欢迎来电预约，或进一步了解我们的诊疗项目。
      </p>
      <CallButton text="立即致电" size="lg" />
    </div>
  </section>
</BaseLayout>
