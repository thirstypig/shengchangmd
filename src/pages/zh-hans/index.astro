---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CallButton from '@components/CallButton.astro';
import { practice } from '@data/practice';

const locale = 'zh-hans';
const title = `${practice.doctorName} | 委员会认证家庭医生 | 加州圣盖博`;
const description = `加州圣盖博的委员会认证家庭医生，并为美国移民局指定体检医师。提供移民医疗服务、公民入籍考试豁免医疗评估报告、医疗法律报告、干细胞治疗与家庭医学。`;
const canonicalUrl = new URL('/zh-hans/', Astro.site).href;
---

<BaseLayout {title} {description} {locale} {canonicalUrl}>
  <HeroSection
    headline="张胜雄 医生"
    subheadline="于圣盖博及邻近社区提供家庭医学诊疗。委员会认证，看诊细心，并提供多语言服务。"
    {locale}
    image="/images/dr-sheng-chang.jpg"
    imageAlt="张胜雄医生肖像"
    imageCaption="委员会认证家庭医生"
  />

  {/* 诊疗项目 */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-container mx-auto px-4 md:px-6">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        诊疗项目
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ServiceCard
          icon="document"
          title="移民医疗服务"
          description="由美国移民局指定体检医师填写并密封 Form I-693，包含必要筛检与疫苗记录审核。"
          href="/zh-hans/services/#immigration-exams"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="shield"
          title="公民入籍考试豁免医疗评估报告"
          description="为因医疗原因无法符合英语或公民常识考试要求的入籍申请人填写 Form N-648。"
          href="/zh-hans/services/#citizenship-waiver"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="chart"
          title="医疗法律报告"
          description="为法律及行政程序撰写医疗报告与评估。"
          href="/zh-hans/services/#medical-legal"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="stethoscope"
          title="干细胞治疗"
          description="本诊所提供干细胞治疗。欢迎致电了解是否适合您的情况。"
          href="/zh-hans/services/#stem-cell-therapy"
          linkLabel="了解更多"
        />
        <ServiceCard
          icon="family"
          title="家庭医学"
          description="为各年龄层患者提供持续照护，从预防保健到急性病症治疗。"
          href="/zh-hans/services/#family-medicine"
          linkLabel="了解更多"
        />
      </div>
    </div>
  </section>

    {/*
    「为何选择张医生」整段于 2026-08-05 依诊所要求移除，包含委员会认证、资历
    与合作医院。The languages list and the accepting-new-patients badge went
    with it — see the note in src/pages/index.astro.
  */}

  {/* 预约 */}
  <section class="py-16 md:py-24 bg-primary-50">
    <div class="max-w-container mx-auto px-4 md:px-6 text-center">
      <h2 class="font-serif text-3xl font-bold mb-6 text-gray-900">准备预约看诊？</h2>
      <p class="text-lg text-gray-700 mb-8">
        欢迎来电预约，或进一步了解我们的诊疗项目。
      </p>
      <CallButton text="立即致电" size="lg" />
    </div>
  </section>
</BaseLayout>
