---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';
import { getTranslation } from '@i18n/locales';

const title = `门诊时间与位置 | ${practice.doctorName} | 圣盖博加州`;
const description = `张医生诊所在圣盖博加州的门诊时间、位置、方向和停车信息。`;
const canonicalUrl = new URL('/zh-hans/location/', Astro.site).href;
---

<BaseLayout
  title={title}
  description={description}
  locale="zh-hans"
  canonicalUrl={canonicalUrl}
>
  <section class="hero-section">
    <h1>门诊时间与位置</h1>
  </section>

  <section class="content-section">
    <div class="content-container">
      <!-- Left Column: Hours & Contact -->
      <div class="content-left">
        <!-- Hours Box -->
        <div class="hours-box">
          <h2>门诊时间</h2>
          <div class="hours-item">
            <span class="label">工作日</span>
            <span class="time">{getTranslation('zh-hans', 'hoursWeekday')}</span>
          </div>
          <div class="hours-item">
            <span class="label">周末</span>
            <span class="time">{getTranslation('zh-hans', 'hoursWeekend')}</span>
          </div>
          <p class="hours-note">
            下班后的来电可以留言。我们会在营业时间回复。
          </p>
        </div>

        <!-- Contact Info -->
        <div class="contact-box">
          <h2>联系我们</h2>
          <div class="contact-item">
            <span class="label">电话</span>
            <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="contact-link">
              {practice.phone}
            </a>
          </div>
          <div class="contact-item">
            <span class="label">地址</span>
            <p class="address-text">
              {practice.address}
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Map & Directions -->
      <div class="content-right">
        <!-- Map Placeholder -->
        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3306.0542156547!2d-118.09534!3d34.08519!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2d5a8f8f8f8f9%3A0x1234567890!2s330%20W%20Las%20Tunas%20Dr%20Suite%203%20San%20Gabriel%20CA%2091776!5e0!3m2!1sen!2sus!4v1234567890"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="谷歌地图显示张医生的办公室位置"
          ></iframe>
        </div>

        <!-- Directions Link -->
        <a href="https://maps.google.com/?q=330+W.+Las+Tunas+Drive,+Suite+3,+San+Gabriel,+CA+91776" target="_blank" rel="noopener noreferrer" class="directions-link">
          获取路线
        </a>

        <!-- Address Card -->
        <div class="address-card">
          <h2>地址</h2>
          <p class="address-full">
            {practice.address}<br />
            San Gabriel, CA 91776
          </p>
        </div>

        <!-- Parking Info -->
        <div class="parking-box">
          <h2>停车</h2>
          <p>
            建筑物停车场提供免费停车。Las Tunas Drive 和周围街道也有街道停车位。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .hero-section {
    padding: 3rem 1rem 2rem;
    text-align: center;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }

  .hero-section h1 {
    font-size: 2.5rem;
    margin: 0;
    font-weight: 700;
    color: var(--text-strong);
    font-family: Georgia, 'Times New Roman', serif;
  }

  .content-section {
    padding: 0 1rem 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .content-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  /* Left Column */
  .content-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hours-box,
  .contact-box,
  .address-card,
  .parking-box {
    padding: 1.5rem;
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .hours-box h2,
  .contact-box h2,
  .address-card h2,
  .parking-box h2 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .hours-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .hours-item .label {
    font-weight: 600;
    color: var(--text-strong);
    min-width: 100px;
  }

  .hours-item .time {
    text-align: right;
    color: var(--text);
  }

  .hours-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 1rem;
    margin-bottom: 0;
    line-height: 1.6;
  }

  .contact-item {
    margin-bottom: 1.25rem;
  }

  .contact-item:last-child {
    margin-bottom: 0;
  }

  .contact-item .label {
    display: block;
    font-weight: 600;
    color: var(--text-strong);
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
  }

  .contact-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-link:hover {
    color: var(--brand-strong);
    text-decoration: underline;
  }

  .contact-link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .address-text {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
  }

  .hours-link-box {
    text-align: center;
  }

  .hours-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--brand);
    color: var(--brand-contrast);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s;
  }

  .hours-link:hover {
    background: var(--brand-strong);
  }

  .hours-link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  /* Right Column */
  .content-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .map-container {
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .map-container iframe {
    display: block;
  }

  .directions-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--brand);
    color: var(--brand-contrast);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    text-align: center;
    transition: background 0.2s;
  }

  .directions-link:hover {
    background: var(--brand-strong);
  }

  .directions-link:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .address-full {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.8;
    margin: 0;
  }

  .parking-box p {
    font-size: 1rem;
    color: var(--text);
    line-height: 1.8;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-section {
      padding: 2rem 1rem 1.5rem;
    }

    .hero-section h1 {
      font-size: 2rem;
    }

    .content-section {
      padding: 0 1rem 2rem;
    }

    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .map-container iframe {
      height: 300px;
    }
  }
</style>
