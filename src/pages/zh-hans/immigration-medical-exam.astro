---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import CallButton from '@components/CallButton.astro';
import ExamFacts from '@components/ExamFacts.astro';
import { practice } from '@data/practice';
import { getExamFaq, examFaqSchema } from '@data/immigrationExam';
import { getTranslation } from '@i18n/locales';

const locale = 'zh-hans';
const title = '移民体检（Form I-693）｜加州圣盖博｜张胜雄医师';
const description =
  '张胜雄医师为美国移民局指定体检医师，于加州圣盖博提供 Form I-693 移民体检。采预约制，并以国语或英语为您说明结果。';
const canonicalUrl = new URL('/zh-hans/immigration-medical-exam/', Astro.site).href;
const faq = getExamFaq(locale);

const breadcrumbs = [
  { label: getTranslation(locale, 'home'), href: '/zh-hans/' },
  { label: getTranslation(locale, 'services'), href: '/zh-hans/services/' },
  { label: '移民体检', href: '/zh-hans/immigration-medical-exam/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  pageSchema={examFaqSchema(locale, canonicalUrl)}
>
  <HeroSection
    headline="移民体检（Form I-693）"
    subheadline="张医师为美国移民局指定体检医师（civil surgeon），移民体检采预约制。"
    locale={locale}
    illustration="immigration"
  />

  <section class="py-12 md:py-16">
    <div class="max-w-container mx-auto px-4 md:px-6">
    <div class="max-w-3xl mx-auto space-y-12">
      <ExamFacts locale={locale} />

      <div>
        <h2 class="font-serif text-2xl md:text-3xl font-bold mb-4 text-gray-900">体检项目</h2>
        <ul class="list-disc pl-6 space-y-2 text-gray-700">
          <li>询问病史，并检阅您带来的病历</li>
          <li>身体检查，包括心理状态评估</li>
          <li>结核病血液检验（IGRA，丙型干扰素释放试验）。若检验结果为阳性，或属其他特定情况，须加照胸部 X 光。</li>
          <li>梅毒血液检验，18 至 44 岁须接受</li>
          <li>淋病检验，18 至 24 岁须接受</li>
          <li>依 CDC 规定，核对您的疫苗接种纪录是否符合您的年龄应接种的疫苗</li>
        </ul>
        <p class="mt-4 text-gray-700">
          您需要做哪些检验，视您的年龄与病史而定。相关规定由美国疾病管制与预防中心（CDC）订定，本诊所依规定办理。资料来源：
          <a href="https://www.cdc.gov/immigrant-refugee-health/hcp/civil-surgeons/index.html" rel="noopener" class="text-primary-700 underline underline-offset-2 hover:no-underline">CDC 体检医师技术指引</a>（英文）。
        </p>
      </div>

      <div>
        <h2 class="font-serif text-2xl md:text-3xl font-bold mb-4 text-gray-900">应携带的资料</h2>
        <ul class="list-disc pl-6 space-y-2 text-gray-700">
          <li>政府核发、附照片的有效身分证件，例如未过期的护照或驾照</li>
          <li>您的疫苗接种纪录</li>
          <li>您手边的其他病历</li>
          <li>已填好第 1 部分（Part 1）的 Form I-693。请先不要签名：您必须在张医师面前签名。</li>
        </ul>
        <p class="mt-4 text-gray-700">
          资料来源：<a href="https://www.uscis.gov/i-693" rel="noopener" class="text-primary-700 underline underline-offset-2 hover:no-underline">美国移民局 Form I-693 页面与填表说明</a>（英文）。
        </p>
      </div>

      <div>
        <h2 class="font-serif text-2xl md:text-3xl font-bold mb-4 text-gray-900">体检流程</h2>
        <ol class="list-decimal pl-6 space-y-3 text-gray-700">
          <li>来电预约。移民体检采预约制。</li>
          <li>依上述项目进行体检。</li>
          <li>
            张医师填妥 Form I-693 后，以密封信封交给您。表格须由您本人（而非医师）送交美国移民局。若以邮寄方式申请 Form I-485，请将
            Form I-693 装在原密封信封内寄出，不可拆封。若在线上申请，美国移民局要求您拆开信封、上传表格，并保留表格正本与信封，直到案件审理完成。
          </li>
          <li>
            送件时间（资讯查核日期：2026 年 9 月 21 日）：美国移民局规定，Form I-693 必须与 Form I-485 一并送件，否则 Form I-485
            可能遭退件。美国移民局已不再要求医师的签名日期须在送件前 60 天内。2023 年 11 月 1 日（含）以后签署的 Form I-693，原则上只适用于与其一并送件的那份申请；若该申请撤回或遭驳回，日后再提出申请时，须附上新的
            Form I-693。资料来源：
            <a href="https://www.uscis.gov/i-693" rel="noopener" class="text-primary-700 underline underline-offset-2 hover:no-underline">美国移民局 Form I-693 页面</a>、
            <a href="https://www.uscis.gov/policy-manual/volume-8-part-b-chapter-4" rel="noopener" class="text-primary-700 underline underline-offset-2 hover:no-underline">美国移民局政策手册第 8 册 B 部分第 4 章</a>（皆为英文）。
          </li>
        </ol>
      </div>

      <div>
        <h2 class="font-serif text-2xl md:text-3xl font-bold mb-4 text-gray-900">
          {getTranslation(locale, 'immigrationExam.faqHeading')}
        </h2>
        <dl class="exam-faq space-y-6">
          {faq.map((q) => (
            <div>
              <dt class="font-semibold text-gray-900">{q.question}</dt>
              <dd class="mt-2 text-gray-700">{q.answer}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="text-center">
        <CallButton text="来电预约体检" size="lg" variant="filled" />
      </div>
    </div>
    </div>
  </section>
</BaseLayout>
