---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';
import { getTranslation } from '@i18n/locales';

/*
 * Mirrors src/pages/new-patients.astro. That page existed only in English while
 * BaseLayout advertised zh-Hant and zh-Hans alternates for it, both 404.
 *
 * The "who we see" list is read from locales.ts rather than written out here.
 * Those exact sentences are the practice's scope limits, supplied by the owner
 * on 2026-08-06, and they already exist as patientScope.* keys. Restating them
 * in a page would be a second copy of a fact, and the next correction would
 * reach only one of them.
 */

const locale = 'zh-hans';
const title = '新患者 | 张胜雄医师';
const description = '欢迎来到张胜雄医师的诊所。了解如何预约初诊，以及初诊当天需要携带的资料。';
const canonicalUrl = new URL('/zh-hans/new-patients/', Astro.site).href;
const telHref = `tel:${practice.phone.replace(/[^\d]/g, '')}`;

const breadcrumbs = [
  { label: getTranslation(locale, 'home'), href: '/zh-hans/' },
  { label: '新患者', href: '/zh-hans/new-patients/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <section class="content-section">
    <div class="content-container">
      <div class="content-left">
        <h1>欢迎新患者</h1>
        <p>
          本诊所现正接受新患者。张医师期待与您见面，延续他数十年来为患者提供的优质而贴心的照护。
        </p>
        {/*
          看诊对象 — 先于「如何预约」出现，与英文版一致：即将来电预约的人，
          应该在拨号前而非拨号后知道本诊所的看诊范围。
        */}
        <h3>{getTranslation(locale, 'patientScope.heading')}</h3>
        <ul>
          <li>{getTranslation(locale, 'patientScope.adults')}</li>
          <li>{getTranslation(locale, 'patientScope.seniors')}</li>
          <li>{getTranslation(locale, 'patientScope.noMinors')}</li>
          <li>{getTranslation(locale, 'patientScope.noObGyn')}</li>
        </ul>
        <h3>如何预约</h3>
        <p>
          请于门诊时间来电 <a href={telHref}>{practice.phone}</a> 预约看诊。本诊所人员将回答您有关保险、可预约时段，以及初诊当天应携带物品的任何问题。
        </p>
        <a href={telHref} class="cta-button">
          来电预约
        </a>
      </div>
      <div class="content-right">
        <div class="info-box">
          <h3>请携带</h3>
          <ul>
            <li>附照片的身分证件</li>
            <li>保险卡</li>
            <li>目前服用的药物清单</li>
            <li>病史资料</li>
            <li>近期的病历纪录</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .content-section {
    padding: 2rem 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .content-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .content-left h1 {
    font-size: 2rem;
    margin: 0 0 1rem;
    font-weight: 700;
  }

  .content-left h3 {
    font-size: 1.2rem;
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
  }

  .content-left p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .content-left a {
    color: var(--brand);
    text-decoration: none;
    font-weight: 600;
  }

  .content-left a:hover {
    text-decoration: underline;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--brand-fill);
    color: var(--on-brand-fill) !important;
    text-decoration: none !important;
    border-radius: 2px;
    font-weight: 600;
    font-size: 1rem;
    transition: background 0.2s;
    margin-top: 0.5rem;
  }

  .cta-button:hover {
    background: var(--brand-fill-strong);
  }

  .info-box {
    background: var(--surface-sunken);
    padding: 1.5rem;
    border-radius: 2px;
    border-left: 4px solid var(--brand);
  }

  .info-box h3 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    font-weight: 600;
  }

  .info-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .info-box li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--text);
  }

  .info-box li:before {
    content: "•";
    color: var(--brand);
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  @media (max-width: 768px) {
    .content-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
