---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';
import { getTranslation } from '@i18n/locales';
import '../../styles/pages/new-patients.css';

/*
 * Mirrors src/pages/new-patients.astro. That page existed only in English while
 * BaseLayout advertised zh-Hant and zh-Hans alternates for it, both 404.
 *
 * The "who we see" list is read from locales.ts rather than written out here.
 * Those exact sentences are the practice's scope limits, supplied by the owner
 * on 2026-08-06, and they already exist as patientScope.* keys. Restating them
 * in a page would be a second copy of a fact, and the next correction would
 * reach only one of them.
 */

const locale = 'zh-hans';
const title = '新患者 | 张胜雄医师 | 加州圣盖博';
const description = '加州圣盖博张胜雄医师诊所的新患者须知：看诊对象、如何预约初诊，以及初诊当天需要携带的资料。';
const canonicalUrl = new URL('/zh-hans/new-patients/', Astro.site).href;
const telHref = `tel:${practice.phone.replace(/[^\d]/g, '')}`;

const breadcrumbs = [
  { label: getTranslation(locale, 'home'), href: '/zh-hans/' },
  { label: '新患者', href: '/zh-hans/new-patients/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <section class="content-section">
    <div class="content-container">
      <div class="content-left">
        <h1>欢迎新患者</h1>
        <p>
          本诊所现正接受新患者。张医师期待与您见面，延续他数十年来为患者提供的优质而贴心的照护。
        </p>
        {/*
          看诊对象 — 先于「如何预约」出现，与英文版一致：即将来电预约的人，
          应该在拨号前而非拨号后知道本诊所的看诊范围。
        */}
        <h3>{getTranslation(locale, 'patientScope.heading')}</h3>
        <ul>
          <li>{getTranslation(locale, 'patientScope.adults')}</li>
          <li>{getTranslation(locale, 'patientScope.seniors')}</li>
          <li>{getTranslation(locale, 'patientScope.noMinors')}</li>
          <li>{getTranslation(locale, 'patientScope.noObGyn')}</li>
        </ul>
        <h3>如何预约</h3>
        <p>
          请于门诊时间来电 <a href={telHref}>{practice.phone}</a> 预约看诊。本诊所人员将回答您有关保险、可预约时段，以及初诊当天应携带物品的任何问题。
        </p>
        <a href={telHref} class="cta-button">
          来电预约
        </a>
      </div>
      <div class="content-right">
        <div class="info-box">
          <h3>请携带</h3>
          <ul>
            <li>附照片的身分证件</li>
            <li>保险卡</li>
            <li>目前服用的药物清单</li>
            <li>病史资料</li>
            <li>近期的病历纪录</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
