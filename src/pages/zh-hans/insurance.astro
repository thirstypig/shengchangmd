---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';
import { getTranslation } from '@i18n/locales';
import '../../styles/pages/insurance.css';

const title = '保险与支付 | 张胜雄医师 | 加州圣盖博';
const description = '加州圣盖博张胜雄医师诊所的保险与费用说明。欢迎来电，我们会与您确认保险给付与就诊费用。';
const canonicalUrl = new URL('/zh-hans/insurance/', Astro.site).href;
const locale = 'zh-hans';

const breadcrumbs = [
  { label: getTranslation('zh-hans', 'home'), href: '/zh-hans/' },
  { label: getTranslation('zh-hans', 'insurance'), href: '/zh-hans/insurance/' },
];
---

<BaseLayout
  title={title}
  description={description}
  locale="zh-hans"
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1>保险与支付</h1>
      <p class="hero-subtitle">欢迎来电，我们会与您确认保险给付与费用</p>
    </div>
  </section>

  <!-- Accepted Plans Section -->
  <section class="content-section">
    <div class="content-container">
      <div class="content-left">
        <h2>保险与费用</h2>
        <h3 class="coverage-heading">{getTranslation(locale, 'coverage.heading')}</h3>
        <ul class="coverage-list">
          <li>{getTranslation(locale, 'coverage.medicare')}</li>
          <li>{getTranslation(locale, 'coverage.mediCal')}</li>
          <li>{getTranslation(locale, 'coverage.hmo')}</li>
          <li>{getTranslation(locale, 'coverage.ppo')}</li>
          <li>{getTranslation(locale, 'coverage.privateInsurance')}</li>
          <li>{getTranslation(locale, 'coverage.cash')}</li>
        </ul>
        <p class="note">
          {getTranslation(locale, 'coverage.confirmNote')}
        </p>
        <p>
          请留意，移民体检、公民入籍考试豁免医疗评估报告及医疗法律报告，通常不在健康保险的给付范围内，因为这些属于行政用途而非治疗。来电时请一并询问，我们会告知您本次就诊的费用。
        </p>
        <p class="note">
          <strong>来电时请备妥您的保险卡。</strong> 诊所电话：<a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`}>{practice.phone}</a>。
        </p>
        {/*
          A fabricated carrier list and three invented payment claims stood in
          this page. See the English source at src/pages/insurance.astro for the
          full account. Nothing here may name a carrier or promise a billing or
          payment term until the practice supplies them.

          UPDATE 2026-08-06. The list above names plan TYPES, not carriers, and
          is published on the owner's written instruction. The confirmNote is
          load-bearing: HMO and PPO are plan structures, not networks. The
          prohibition on carrier names, carrier logos and "most major plans"
          phrasing is unchanged.
        */}
      </div>
      <div class="content-right">
        <div class="info-box">
          <h3>确认您的保险给付</h3>
          <p>
            就诊前请先来电本诊所，我们会为您确认保险给付、自付额，以及是否需要事前授权。
          </p>
          <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="cta-button">
            来电确认给付
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Payment Options Section -->
  <section class="payment-section">
    <h2>支付选项</h2>
    <div class="payment-grid">
      <div class="payment-card">
        <h3>就诊前</h3>
        <p>
          请致电诊所，提供您的保险资料并告知您要预约的服务项目。我们会告诉您哪些项目有给付，以及您预计需要支付的金额。
        </p>
      </div>
      <div class="payment-card">
        <h3>自费就诊</h3>
        <p>
          许多患者选择自费，移民与各类报告服务尤其如此。请于来电时询问费用，以免当天出现预期之外的支出。
        </p>
      </div>
    </div>
  </section>

  <!-- Questions Section -->
  <section class="questions-section">
    <div class="questions-content">
      <h2>有关保险或账单的问题？</h2>
      <p>
        {/* Removed an unsupplied staff-competence claim — see zh-hant/insurance.astro. */}
        欢迎来电，我们会与您说明保险给付、账单与就诊费用。
      </p>
      <a href={`tel:${practice.phone.replace(/[^\d]/g, '')}`} class="cta-button-large">
        立即致电我们
      </a>
      <p class="contact-info">
        {practice.phone} | {getTranslation('zh-hans', 'hoursWeekday')}
      </p>
    </div>
  </section>
</BaseLayout>
