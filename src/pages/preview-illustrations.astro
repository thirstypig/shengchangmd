---
/**
 * TEMPORARY preview page for choosing an illustration style.
 * Filename starts with `_` so Astro does not build it as a route.
 * Delete once a style is chosen.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceIllustration from '@components/ServiceIllustration.astro';

const subjects = [
  { id: 'family', label: 'Family Medicine' },
  { id: 'internal', label: 'Internal Medicine' },
  { id: 'preventive', label: 'Preventive Care' },
  { id: 'chronic', label: 'Chronic Disease Management' },
  { id: 'immigration', label: 'Immigration Medical Exams' },
];
---

<BaseLayout
  title="Illustration style preview"
  description="Internal preview"
  locale="en"
  canonicalUrl="https://shengchangmd.com/"
>
  <section class="py-12 max-w-container mx-auto px-6">
    <h1 class="font-serif text-3xl font-bold mb-2">Illustration options</h1>
    <p class="text-gray-700 mb-10">Same drawings, two treatments.</p>

    <h2 class="font-serif text-2xl font-bold mb-6">Option A — “soft” (duotone)</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6 mb-16">
      {
        subjects.map((s) => (
          <div>
            <ServiceIllustration subject={s.id} style="soft" />
            <p class="text-sm text-gray-600 mt-3 text-center">{s.label}</p>
          </div>
        ))
      }
    </div>

    <h2 class="font-serif text-2xl font-bold mb-6">Option B — “line” (monoline)</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
      {
        subjects.map((s) => (
          <div>
            <ServiceIllustration subject={s.id} style="line" />
            <p class="text-sm text-gray-600 mt-3 text-center">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
