---
import BaseLayout from '@layouts/BaseLayout.astro';
import { practice } from '@data/practice';

const title = `Privacy Policy | ${practice.doctorName}`;
const description = `Privacy policy for the practice website of ${practice.doctorName}.`;
const canonicalUrl = new URL('/privacy/', Astro.site).href;
---

<BaseLayout
  title={title}
  description={description}
  locale="en"
  canonicalUrl={canonicalUrl}
>
  <h1>Privacy Policy</h1>
  <p>Coming soon.</p>
</BaseLayout>
